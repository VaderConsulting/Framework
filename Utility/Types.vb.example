Public Class Types

#Region " Structures "

    Public Structure Status
        Public CADS_ERRORCODE As Int32
        Public LastException As Exception

        Public Sub Clear()
            LastException = Nothing
            CADS_ERRORCODE = ERRORTYPE.NONE
        End Sub

    End Structure

    Public Structure ExtensionRange
        Dim StartNumber As String
        Dim FinishNumber As String
    End Structure

    Public Structure StreetAddress
        Dim Number As String
        Dim Street As String
        Dim Suburb As String
        Dim State As String
        Dim Postcode As String
        Dim Country As String
    End Structure

    Public Structure CostCentre
        Dim ID As Int32
        Dim Code As String
        Dim Manager As String
    End Structure

    Public Structure PhysicalLocation
        Dim ID As Int32
        Dim Name As String
        Dim Description As String
        Dim Address As StreetAddress
        Dim Manager As String
        Dim PABX As PABXInformation()
        Dim CostCentre As CostCentre
    End Structure

    Public Structure PABXInformation
        Dim ExtensionRange As ExtensionRange()
        Dim IndialRange As ExtensionRange()
        Dim Costcode As String
        Dim SiteAccessCode As String
    End Structure

    Public Structure Phone
        Dim Number As String
        Dim Manager As String
        Dim Department As String
        Dim Location As String
        Dim DirectoryPath As String
        Dim User As String
        Dim PhoneType As TELEPHONE_TYPE
    End Structure

    Public Structure CreateUserException
        Dim TheUser As Object
        Dim TheUserObjectType As String
        Dim TheError As Object
        Dim TheErrorObjectType As String
    End Structure

    ''' <summary>
    ''' A representation of an Active Directory or ADAM user
    ''' </summary>
    ''' <remarks></remarks>
    Public Structure DirectoryUser

        ''' <summary>
        ''' Active Directory Attribute 'comment'
        ''' </summary>
        ''' <remarks></remarks>
        Public Comment

        ''' <summary>
        ''' Active Directory Attribute 'distinguishedName'
        ''' </summary>
        ''' <remarks></remarks>
        Public distinguishedName As String

        ''' <summary>
        ''' Active Directory Attribute 'displayName()'
        ''' </summary>
        ''' <remarks></remarks>
        Public DisplayName As String

        ''' <summary>
        ''' Active Directory Attribute 'name()'
        ''' </summary>
        ''' <remarks></remarks>
        Public Name As String

        ''' <summary>
        ''' Active Directory Attribute 'cn(common name)'
        ''' </summary>
        ''' <remarks></remarks>
        Public CommonName As String

        ''' <summary>
        ''' Active Directory Attribute 'otherTelephone(Phone-Office-Other)'
        ''' </summary>
        ''' <remarks></remarks>
        Public OfficeTelephoneNumber As String

        ''' <summary>
        ''' Active Directory Attribute '(Title)'
        ''' </summary>
        ''' <remarks>CADS 3 </remarks>
        Public Title As String

        ''' <summary>
        ''' Active Directory Attribute '(Locality-Name)'
        ''' </summary>
        ''' <remarks></remarks>
        Public Suburb As String

        ''' <summary>
        ''' Active Directory Attribute ' (Facsimile-Telephone-Number)'
        ''' </summary>
        ''' <remarks></remarks>
        Public FacsimileTelephoneNumber As String

        ''' <summary>
        ''' Active Directory Attribute ' (Phone-Mobile-Primary)'
        ''' </summary>
        ''' <remarks></remarks>
        Public MobileTelephoneNumber As String

        ''' <summary>
        ''' Active Directory Attribute ' (Surname)'
        ''' </summary>
        ''' <remarks></remarks>
        Public Surname As String

        ''' <summary>
        ''' Active Directory Attribute ' (Given-Name)'
        ''' </summary>
        ''' <remarks></remarks>
        Public GivenName As String

        ''' <summary>
        ''' Active Directory Attribute ''
        ''' </summary>
        ''' <remarks></remarks>
        Public Department As String

        ''' <summary>
        ''' Active Directory Attribute ' (Employee-Number)'
        ''' </summary>
        ''' <remarks></remarks>
        Public EmployeeNumber As String

        ''' <summary>
        ''' Active Directory Attribute ' (Telephone-Number)'
        ''' </summary>
        ''' <remarks></remarks>
        Public TelephoneNumber As String

        ''' <summary>
        ''' Active Directory Attribute 'description' (Description)
        ''' </summary>
        ''' <remarks></remarks>
        Public Description As String

        ''' <summary>
        ''' Active Directory Attribute 'manager' (Manager)
        ''' </summary>
        ''' <remarks></remarks>
        Public Manager As String

        ''' <summary>
        ''' Temporary field - used for migration purposes only
        ''' </summary>
        ''' <remarks>V1.0 D. Robinson</remarks>
        Public TemporaryField1 As String

        ''' <summary>
        ''' Temporary field - used for migration purposes only
        ''' </summary>
        ''' <remarks>V1.0 D. Robinson</remarks>
        Public TemporaryField2 As String

        ''' <summary>
        ''' Temporary field - used for migration purposes only
        ''' </summary>
        ''' <remarks>V1.0 D. Robinson</remarks>
        Public TemporaryField3 As String

        ''' <summary>
        ''' Temporary field - used for migration purposes only
        ''' </summary>
        ''' <remarks>V1.0 D. Robinson</remarks>
        Public TemporaryField4 As String

        ''' <summary>
        ''' Temporary field - used for migration purposes only
        ''' </summary>
        ''' <remarks>V1.0 D. Robinson</remarks>
        Public TemporaryField5 As String

        ''' <summary>
        ''' Temporary field - used for migration purposes only
        ''' </summary>
        ''' <remarks>V1.0 D. Robinson</remarks>
        Public TemporaryField6 As String

        ''' <summary>
        ''' Temporary field - used for migration purposes only
        ''' </summary>
        ''' <remarks>V1.0 D. Robinson</remarks>
        Public TemporaryField7 As String

        ''' <summary>
        ''' Temporary field - used for migration purposes only
        ''' </summary>
        ''' <remarks>V1.0 D. Robinson</remarks>
        Public TemporaryField8 As String

        ''' <summary>
        ''' Temporary field - used for migration purposes only
        ''' </summary>
        ''' <remarks>V1.0 D. Robinson</remarks>
        Public TemporaryField9 As String

        ''' <summary>
        ''' Temporary field - used for migration purposes only
        ''' </summary>
        ''' <remarks>V1.0 D. Robinson</remarks>
        Public TemporaryField10 As String

        Public OtherPropertiesStringCollection As Collections.Specialized.StringCollection

        Public UID As String

    End Structure

    ''' <summary>
    ''' A representation of a CADS3 user
    ''' </summary>
    ''' <remarks></remarks>
    Public Structure CADS3User

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>Replaced by Group membership</remarks>
        ''' 
        Public Site As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks></remarks>
        Public SiteAddress As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks></remarks>
        Public CostCentreCode As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>AD entry: OtherTelephone (Phone-Office-Other)</remarks>
        '''
        Public TelephoneExtensionNumber As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>AD entry: sn (Surname)</remarks>
        ''' 
        Public Surname As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>AD entry: givenName (Given-Name)</remarks>
        '''         
        Public FirstName As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>N/A - can be replaced by Group membership</remarks>
        ''' 
        Public OfficeAddress As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>AD entry: title (Title)</remarks>
        ''' 
        Public Title As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>AD entry: l (Locality-Name)</remarks>
        ''' 
        Public Suburb As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>AD entry: facsimileTelephoneNumber (Facsimile-Telephone-Number)</remarks>
        ''' 
        Public FacsimileTelephoneNumber As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>AD entry: mobile (Phone-Mobile-Primary)</remarks>
        ''' 
        Public MobileTelephoneNumber As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>AD entry: division</remarks>
        ''' 
        Public Division As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks></remarks>
        ''' 
        Public BusinessUnit As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>AD entry: department* (AND OU Level 2)</remarks>
        ''' 
        Public Department As String

        ''' <summary>
        ''' CADS3 Field
        ''' </summary>
        ''' <remarks>AD entry: telephoneNumber (Telephone-Number)</remarks>
        ''' 
        Public TelephoneNumber As String

        ''' <summary>
        ''' CADS3 Field ''
        ''' </summary>
        ''' <remarks>AD entry: employeeNumber (Employee-Number)</remarks>
        ''' 
        Public CADS3_ID As String

        ''' <summary>
        ''' CADS3 Field ''
        ''' </summary>
        ''' <remarks>N/A - not required (or Description field can be substituted)</remarks>
        ''' 
        Public In_Out As String

        ''' <summary>
        ''' CADS3 Field ''
        ''' </summary>
        ''' <remarks>N/A - not required (or Description field can be substituted)</remarks>
        ''' 
        Public CommentsField1 As String

        ''' <summary>
        ''' CADS3 Field ''
        ''' </summary>
        ''' <remarks>N/A - not required (or Description field can be substituted)</remarks>
        ''' 
        Public CommentsField2 As String

        ''' <summary>
        ''' CADS3 Field ''
        ''' </summary>
        ''' <remarks>N/A - not required (or Description field can be substituted)</remarks>
        ''' 
        Public CommentsField3 As String

        ''' <summary>
        ''' CADS3 Field ''
        ''' </summary>
        ''' <remarks>N/A - not required (or Description field can be substituted)</remarks>
        ''' 
        Public CommentsField4 As String

        ''' <summary>
        ''' CADS3 Field ''
        ''' </summary>
        ''' <remarks>N/A - not required (or Description field can be substituted)</remarks>
        ''' 
        Public CommentsField5 As String

        ''' <summary>
        ''' CADS3 Field ''
        ''' </summary>
        ''' <remarks>N/A - not required (or Description field can be substituted)</remarks>
        ''' 
        Public CommentsField6 As String

        ''' <summary>
        ''' CADS3 Field ''
        ''' </summary>
        ''' <remarks>N/A - not required (or Description field can be substituted)</remarks>
        ''' 
        Public CommentsField7 As String

        ''' <summary>
        ''' CADS3 Field ''
        ''' </summary>
        ''' <remarks>N/A - not required (or Description field can be substituted)</remarks>
        ''' 
        Public CommentsField8 As String

        ''' <summary>
        ''' CADS Import Custom Field
        ''' </summary>
        ''' <remarks></remarks>

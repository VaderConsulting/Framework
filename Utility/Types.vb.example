#End Region

#Region " Enums "

    ''' <summary>
    ''' CADS Specific Error types
    ''' </summary>
    ''' <remarks>V1.0  D. Robinson</remarks>
    ''' 
    Public Enum ERRORTYPE
        NONE = -1
        SUCCESS = 0
        FILESYSTEM = 1
        CONFIGURATION = 2
        SECURITY = 3
        CRYPT = 4
        DIRECTORY = 5
        UNSPECIFIED = 99
    End Enum

    Public Enum ERROR_FILESYSTEM
        DIRECTORY_NOT_FOUND = 1
        FILE_NOT_FOUND = 2
        FILE_READ = 3
        FILE_WRITE = 4
        FILE_IO = 99
    End Enum

    Public Enum ERROR_CONFIGURATION
        SETTING_NOT_FOUND = 1
        STRING_READ_ERROR = 2
        SECTION_NOT_FOUND = 3
        WRITE_NOT_SUPPORTED = 4
        WRITE_ERROR = 5
        WRITE_NOT_PERFORMED = 6
        STRING_WRITE_ERROR = 7
        ATTRIBUTE_NOT_FOUND = 8
        ATTRIBUTE_ALREADY_EXISTS = 9
        SETTING_CREATE_ERROR = 10
        SETTING_DELETE_ERROR = 11
        SETTING_READ_ERROR = 12
        SECTION_READ_ERROR = 13
        SECTION_WRITE_ERROR = 14
        SECTION_CREATE_ERROR = 15
        SECTION_DELETE_ERROR = 16
        ATTRIBUTE_READ_ERROR = 17
        ATTRIBUTE_WRITE_ERROR = 18
        ATTRIBUTE_CREATE_ERROR = 19
        ATTRIBUTE_DELETE_ERROR = 20
        CONFIG_SERVER_TIMEOUT_ERROR = 98
        MASTER_CONFIG_NOT_FOUND = 99
    End Enum

    Public Enum ERROR_SECURITY
        COULD_NOT_CREATE_OBJECT = 1
        COULD_NOT_READ_OBJECT = 2
        COULD_NOT_WRITE_OBJECT = 3
        AUTHENTICATION_FAILURE = 5
        AUTOLOGON_FAILURE = 6
        AUTOLOGON_DISABLED = 7
        INCORRECT_USERNAME = 8
        INCORRECT_PASSWORD =REDACTED
        NOT_AUTHORISED = 10
        USERNAME_NOT_SPECIFIED = 11
        GENERIC_SECURITY_ERROR = 99
    End Enum

    Public Enum ERROR_CRYPT
        ENCRYPTION_ERROR = 1
        DECRYPTION_ERROR = 2
        GENERAL_ERROR = 3
    End Enum

    Public Enum ERROR_UNSPECIFIED
        NOT_IMPLEMENTED = 1
        SYNTAX_ERROR = 2
        WRONG_OBJECT_TYPE = 3
        NO_VALUES_SPECIFIED = 4
        INTERNAL_ERROR = 5
        OTHER = 99
    End Enum

    Public Enum ERROR_DIRECTORY
        REFERRAL_RETURNED = 1
        DIRECTORY_ERROR = 2
        NO_USERNAME = 3
        NO_PASSWORD =REDACTED
        AUTHENTICATION_FAILURE = 5
        SERVER_NOT_FOUND = 6
        REQUEST_TIMEOUT = 7
        CREATE_USER_ERROR = 8
        CREATE_OU_ERROR = 9
        OTHER = 99
    End Enum

    ''' <summary>
    ''' Indicates the type of logging to employ
    ''' </summary>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Enum LOGGING_TYPE
        LOGFILE = 1
        EMAIL = 2
        COMPUTER_EVENT_LOG = 4
    End Enum

    ''' <summary>
    ''' Indicates the type of information to log
    ''' </summary>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Enum LOGGING_LEVEL
        ERRORS = 1        ' WILL ALWAYS BE LOGGED
        WARNING = 2
        INFORMATION = 4
        DEBUGGING = 255
    End Enum

    Public Enum TELEPHONE_TYPE
        MOBILE = 2
        FIXED = 4
        PAGER = 5
        FAX = 10
        OFFICE_EXTENSION = 11
        HOME = 12
    End Enum

    Public Enum USER_ACCOUNT_CONTROL_FLAG
        SCRIPT = &H1
        ACCOUNT_DISABLED = &H2
        HOMEDIR_REQUIRED = &H8
        LOCKED_OUT = &H10                          ' Not used by Active Directory
        PASSWD_NOT_REQD = &H20
        PASSWD_CANT_CHANGE = &H40                  ' Not used by Active Directory
        ENCRYPTED_TEXT_PASSWD_ALLWD = &H80
        TEMP_DUPLICATE_ACCT = &H100
        NORMAL_ACCOUNT = &H200
        INTERDOMAIN_TRUST_ACCT = &H800
        WORKSTATION_TRUST_ACCT = &H1000
        SERVER_TRUST_ACCT = &H2000
        PASSWD_NO_EXPIRE = &H10000
        MNS_LOGON_ACCT = &H20000
        SMART_CART_REQD = &H40000
        TRUSTED_FOR_DELEGATION = &H80000
        NOT_DELEGATED = &H100000
        USE_DES_KEY_ONLY = &H200000
        PREAUTH_NOT_REQD = &H400000
        PASSWD_EXPIRED = &H800000                   ' Not used by Active Directory
        TRUSTED_TO_AUTH_FOR_DELEGATION = &H1000000
        NOAUTHDATAREQUIRED = &H2000000
    End Enum

    Public Enum SERVER_TYPE
        PRIMARY = 1
        SECONDARY = 2
        TERTIARY = 3
    End Enum

    Public Enum SERVICE_STATE
        UNKNOWNSTATE = 0
        STOPPED = 1
        STARTED = 2
    End Enum

    Public Enum ATTRIBUTE_FORMAT_TYPE
        NO_FORMAT = 0
        STRING_FORMAT = 1
        NUMBER_FORMAT = 2
        INTEGER_FORMAT = 3
        CURRENCY_FORMAT = 4
        DATE_FORMAT = 5
        TIME_FORMAT = 6
        DATE_TIME_FORMAT = 7
        CUSTOM_FORMAT = 8
        YES_NO_FORMAT = 9
        ON_OFF_FORMAT = 10
        TRUE_FALSE_FORMAT = 11
        DISTINGUISHED_NAME_FORMAT = 12
        DIRECTORY_DATE_TIME = 13
        DIRECTORY_GUID_FORMAT = 14
    End Enum

#End Region

End Class


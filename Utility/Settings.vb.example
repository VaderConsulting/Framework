    Protected Overrides Sub Finalize()
        If TargetDirectoryUser IsNot Nothing Then
            TargetDirectoryUser.Close()
            TargetDirectoryUser = Nothing
        End If

        ' Resume normal operation
        MyBase.Finalize()
    End Sub

    Private Sub DoStartup()
        FileLoggingObject.LogType = LoggingType.LogFile
        InteractiveUserUsername = My.User.Name

        Try
            CurrentADSitename = My.Computer.Registry.GetValue("HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NetLogon\Parameters", "DynamicSiteName", "")
        Catch ex As Exception

            FileLoggingObject.WriteErrorEvent("Error reading AD Sitename from registry path")
        End Try
    End Sub

    Private m_ConfigurationFile As New ConfigFile
    'Private m_Settings As New Settings

    Public Property ConfigFile() As ConfigFile
        Get
            Return m_ConfigurationFile
        End Get
        Set(ByVal value As ConfigFile)
            m_ConfigurationFile = value
        End Set
    End Property


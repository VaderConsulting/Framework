#Region " Methods "

    ''' <summary>
    ''' Check if the given Directory path exists
    ''' </summary>
    ''' <param name="DirectoryPath">Fully qualified LDAP Path in the form 'LDAP://[Server:Port/]dc=Name,dc=COM'</param>
    ''' <returns>Boolean value indicating the result of the search</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function LDAPObjectExists(ByVal DirectoryPath As String) As Boolean
        Dim oSearcher As New DirectorySearcher()

        Try
            With oSearcher
                .SearchRoot = New DirectoryEntry(DirectoryPath)
                .SearchScope = SearchScope.Subtree
                .Filter = "(objectClass=*)"
                .FindOne()
            End With
            oSearcher = Nothing

            LastStatus.CADS_ERRORCODE = SUCCESS
            LastStatus.LastException = Nothing
            'Settings.LastError = ApplicationStatus
            Return True
        Catch ex As Exception
            ' Nothing required here.  An incorrect path will result in an exception which is ok.
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = SUCCESS
            Return False
        End Try

    End Function

    ''' <summary>
    ''' Checks if the given Object name exists in the Directory
    ''' </summary>
    ''' <param name="distinguishedName">An object name to look for</param>
    ''' <returns>Boolean value indicating the result of the search</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function ObjectExists(ByVal distinguishedName As String) As Boolean
        Try
            If distinguishedName.StartsWith("LDAP://") Then
                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = Nothing
                Return DirectoryEntry.Exists(distinguishedName)
            Else
                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = Nothing
                Return DirectoryEntry.Exists(GlobalSettings.TargetDirectoryServerAndPort & distinguishedName)
            End If

        Catch ex As Exception
            Select Case ex.Message.ToString.Trim
                Case "A referral was returned from the server."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.REFERRAL_RETURNED
                    LastStatus.LastException = ex
                    Return False
                Case "A local error has occurred."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.DIRECTORY_ERROR
                    LastStatus.LastException = ex
                    Return False
                Case Else
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.AUTHENTICATION_FAILURE
                    LastStatus.LastException = ex
                    Return False
            End Select
        End Try

    End Function

    ''' <summary>
    ''' Check the given Username and Password against the given AD Server
    ''' </summary>
    ''' <param name="DirectoryPath">Fully qualified LDAP Path in the form 'LDAP://[Server:Port/]dc=Name,dc=COM'</param>
    ''' <param name="DomainAndUsername">The Username to check (including Domain Name)</param>
    ''' <param name="Password">The Password to check</param>
    ''' <returns>Boolean value indicating the result</returns>
    ''' <remarks></remarks>
    Public Function CheckADPassword(ByVal DirectoryPath As String, ByVal DomainAndUsername As String, ByVal Password As String) As Boolean
        Dim de As DirectoryEntry = New DirectoryEntry(DirectoryPath, DomainAndUsername, Password)

        Try
            'Bind to the native AdsObject to force authentication.
            Dim obj As Object = de.NativeObject
            Try
                Dim Search As DirectorySearcher = New DirectorySearcher(de)

                Search.Filter = "(sAMAccountName=" & DomainAndUsername.Substring(DomainAndUsername.IndexOf("\") + 1) & ")"
                Search.PropertiesToLoad.Add("cn")
                Dim SearchResult As SearchResult = Search.FindOne()

                If (SearchResult Is Nothing) Then
                    LastStatus.CADS_ERRORCODE = SUCCESS
                    LastStatus.LastException = Nothing
                    de.Close()
                    Return False
                End If

                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = Nothing
                Return True
            Catch ex As Exception
                ' Nothing required here.  An incorrect path will result in an exception which is ok.
                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = ex
                de.Close()
                Return False
            End Try
        Catch ex As Exception
            Select Case ex.Message.ToString.Trim
                Case "A referral was returned from the server."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.REFERRAL_RETURNED
                    LastStatus.LastException = ex
                    Return False
                Case "A local error has occurred."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.DIRECTORY_ERROR
                    LastStatus.LastException = ex
                Case Else
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.AUTHENTICATION_FAILURE
                    LastStatus.LastException = ex
                    Return False
            End Select
        End Try

    End Function

    ''' <summary>
    ''' Check the given Username and Password against the given ADAM Server
    ''' </summary>
    ''' <param name="DirectoryPath">Fully qualified LDAP Path in the form 'LDAP://[Server:Port/]dc=Name,dc=COM'</param>
    ''' <param name="Username">The Username to check</param>
    ''' <param name="Password">The Password to check</param>
    ''' <returns>Boolean value indicating the result</returns>
    ''' <remarks></remarks>
    Public Function CheckADAMPassword(ByVal DirectoryPath As String, ByVal Username As String, ByVal Password As String) As Boolean
        Dim de As DirectoryEntry = New DirectoryEntry(DirectoryPath, Username, Password, AuthenticationTypes.ServerBind)

        Try
            'Bind to the native AdsObject to force authentication.
            Dim obj As Object = de.NativeObject
            Try
                Dim Search As DirectorySearcher = New DirectorySearcher(de)

                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = Nothing
                de.Close()

                Return True
            Catch ex As Exception
                ' Nothing required here.  An incorrect path will result in an exception which is ok.
                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = ex
                de.Close()

                Return False
            End Try
        Catch ex As Exception
            de.Close()
            Select Case ex.Message.ToString.Trim
                Case "A referral was returned from the server."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.REFERRAL_RETURNED
                    LastStatus.LastException = ex

                    Return False
                Case "A local error has occurred."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.DIRECTORY_ERROR
                    LastStatus.LastException = ex

                    Return False
                Case "Logon failure: unknown user name or bad password."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.AUTHENTICATION_FAILURE
                    LastStatus.LastException = ex

                    Return False
                Case Else
                    LastStatus.CADS_ERRORCODE = ERROR_SECURITY.GENERIC_SECURITY_ERROR
                    LastStatus.LastException = ex

                    Return False
            End Select

        End Try

    End Function

    ''' <summary>
    ''' Creates a Organizational unit to callers criteria
    ''' </summary>
    ''' <param name="NewOUDistinguishedName">The path of the new OU</param>
    ''' <returns>CADS4 ERROR_CODE</returns>
    ''' <remarks>V1.1 D. Robinson</remarks>
    Public Function CreateOU(ByVal NewOUDistinguishedName As String) As Boolean
        Try
            Dim Root As DirectoryEntry     ' Binding object.
            Dim OU As DirectoryEntry       ' Organizational Unit.
            Dim OUName As String           ' Organizational Unit Name.
            Dim Path As String             ' Binding path.

            ' Construct the binding string.
            Path = NewOUDistinguishedName

            If Not NewOUDistinguishedName.StartsWith("LDAP://") Then
                OUName = Path
            Else
                ' Specify Organizational Unit.
                Dim i As Integer = Path.IndexOf("//", 0)
                OUName = Path.Remove(0, i + 2)
                Dim j As Integer = OUName.IndexOf("/", 0)
                OUName = OUName.Remove(j)

                'Specify the path.
                Path = Path.Remove(i + 2, j + 1)
            End If

            Root = New DirectoryEntry(Path)
            Root.RefreshCache()
            OU = Root.Children.Add(OUName, "OrganizationalUnit")

            OU.CommitChanges()
            OU.Close()

            LastStatus.CADS_ERRORCODE = SUCCESS
            LastStatus.LastException = Nothing

            Return True
        Catch ex As Exception
            LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.OTHER
            LastStatus.LastException = ex

            Return False
        End Try

    End Function


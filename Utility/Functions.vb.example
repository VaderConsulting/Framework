    ''' <summary>
    ''' Translates the ERROR_DIRECTORY code into the CADS_ERRORCODE
    ''' </summary>
    ''' <param name="ErrorType">One of the defined CADS_ERROR_TYPES</param>
    ''' <param name="ErrorNumber">The ERROR_DIRECTORY value to translate</param>
    ''' <returns>The CADS_ERRORCODE</returns>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Function ErrorResult(ByVal ErrorType As ERRORTYPE, ByVal ErrorNumber As ERROR_DIRECTORY) As Int32
        Dim Result As Int32 = (ErrorType * (2 ^ 16)) + ErrorNumber

        Return Result
    End Function

    ''' <summary>
    ''' Function to return the text value based on the index provided
    ''' </summary>
    ''' <param name="ErrorCode">The value we're looking for</param>
    ''' <returns>A description of the Error</returns>
    ''' <remarks>V1.1 D. Robinson</remarks>
    Public Function GetErrorTypeAndCode(ByVal ErrorCode As Int32) As String
        Dim ErrorString As String = ""
        ' The passed-in Error code has two portions:
        ' 1. Error type
        ' 2. Error code (local)

        ' Firstly, extract the type
        Dim ErrorType As Int16 = (ErrorCode / (2 ^ 16))
        ErrorString = "(" & [Enum].GetName(GetType(ERRORTYPE), ErrorType) & ") "

        ' Now determine the code
        Dim Remainder As Int16 = ErrorCode - (ErrorType * (2 ^ 16))

        ' The output will look something like the following:
        ' "(ERROR_FILESYSTEM) DIRECTORY_NOT_FOUND"
        Select Case ErrorType
            Case -1
                ErrorString &= "Nothing"
            Case 0
                ErrorString &= "None"
            Case 1
                ErrorString &= [Enum].GetName(GetType(ERROR_FILESYSTEM), Remainder)
            Case 2
                ErrorString &= [Enum].GetName(GetType(ERROR_CONFIGURATION), Remainder)
            Case 3
                ErrorString &= [Enum].GetName(GetType(ERROR_SECURITY), Remainder)
            Case 4
                ErrorString &= [Enum].GetName(GetType(ERROR_CRYPT), Remainder)
            Case 5
                ErrorString &= [Enum].GetName(GetType(ERROR_DIRECTORY), Remainder)
            Case 99
                ErrorString &= [Enum].GetName(GetType(ERROR_UNSPECIFIED), Remainder)
            Case Else
                ErrorString &= "UNSUPPORTED_ERROR_VALUE"
        End Select

        Return ErrorString
    End Function

    ''' <summary>
    ''' Saves an object to disk
    ''' </summary>
    ''' <param name="Filename">The output filename</param>
    ''' <param name="ObjectToSerialize">An object to serialize</param>
    ''' <returns>SUCCESS or CADS_ERRORCODE</returns>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Function Serialize(ByVal Filename As String, ByVal ObjectToSerialize As Object) As Int32
        Dim fs As New IO.FileStream(Filename, System.IO.FileMode.Create)
        Dim formatter As New Formatters.Soap.SoapFormatter

        Try
            formatter.Serialize(fs, ObjectToSerialize)

            fs.Close()
            fs = Nothing
            Return SUCCESS
        Catch ex As Exception
            Return ErrorResult(FILESYSTEM, FILE_WRITE)
        End Try
    End Function

    ''' <summary>
    ''' Loads an object from disk
    ''' </summary>
    ''' <param name="PathAndFilename">The input filename</param>
    ''' <param name="DeserializedObject">The deserialized object</param>
    ''' <returns>SUCCESS or CADS_ERRORCODE</returns>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Function Deserialize(ByVal PathAndFilename As String, ByRef DeserializedObject As Object) As Int32
        Dim fs As New IO.FileStream(PathAndFilename, System.IO.FileMode.Open)
        Dim formatter As New Formatters.Soap.SoapFormatter

        Try
            DeserializedObject = formatter.Deserialize(fs)

            fs.Flush()
            fs.Close()
            Return SUCCESS
        Catch ex As Exception
            Return ErrorResult(FILESYSTEM, FILE_READ)
        End Try
    End Function

    ''' <summary>
    ''' Returns a string representation of the input string collection, separated by the Separator character
    ''' </summary>
    ''' <param name="InputCollection">The Input StringCollection</param>
    ''' <param name="Separator">The input Separator to use</param>
    ''' <returns>String</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function StringFromStringCollection(ByVal InputCollection As Specialized.StringCollection, ByVal Separator As String) As String
        Dim OutputString As String = ""

        For Each InputString As String In InputCollection
            OutputString &= InputString & Separator
        Next

        If Right(OutputString, Len(Separator)) = Separator Then ' remove last separator character(s)
            OutputString = Left(OutputString, Len(OutputString) - Len(Separator))
        End If

        Return OutputString.Trim
    End Function

    ''' <summary>
    ''' Returns a string representation of the input string collection, separated by the Separator character
    ''' </summary>
    ''' <param name="InputCollection">The Input StringCollection</param>
    ''' <param name="Separator">The input Separator to use</param>
    ''' <returns>String</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function StringFromOrderedDictionary(ByVal InputCollection As Specialized.OrderedDictionary, ByVal Separator As String) As String
        Dim OutputString As String = ""

        Dim i As Int16

        For Each Value As String In InputCollection.Values
            i += 1
            OutputString &= Value & Separator
        Next

        If Right(OutputString, Len(Separator)) = Separator Then ' remove last separator character(s)
            OutputString = Left(OutputString, Len(OutputString) - Len(Separator))
        End If

        Return OutputString.Trim
    End Function

    Public Function ValueFromSetting(ByVal ValueSettingCombination As String, Optional ByVal ArrayItemNumber As Integer = 0, Optional ByVal Delimiter As String = "|") As String
        Dim Result As String
        Dim Items() As String

        If ValueSettingCombination <> Constants.DEFAULTSTRINGVALUE Then

            Result = ValueSettingCombination
            Items = Split(ValueSettingCombination, Delimiter)
            Result = Items(ArrayItemNumber)
            'Result = ValueSettingCombination.Substring(0, ValueSettingCombination.IndexOf(Delimiter))

            Return Result
        Else
            Return Constants.DEFAULTSTRINGVALUE
        End If
    End Function

    Public Function DetermineTargetServerName(ByVal ServerNames() As String) As String
        Dim Server As String = ""
        Dim Index As Integer = 0
        Dim ServerUp As Boolean = False
        Dim PingAttempt As Integer = 0

        If ServerNames.Length = 0 Then
            Return Constants.DEFAULTSTRINGVALUE
        End If

        Do
            Server = ServerNames(Index)

            If Server.Contains(":") Then
                Server = Server.Substring(0, Server.IndexOf(":"))
            End If

            Do
                PingAttempt += 1
                FileLoggingObject.WriteEvent("Attempt number " & PingAttempt.ToString & " to contact Server '" & Server & "'", LOGGING_LEVEL.DEBUGGING)

                Try
                    FileLoggingObject.WriteEvent("Pinging " & Server, LOGGING_LEVEL.DEBUGGING)
                    If My.Computer.Network.Ping(Server) Then
                        ServerUp = True
                        FileLoggingObject.WriteEvent("Server was found", LOGGING_LEVEL.DEBUGGING)
                    End If
                Catch ex As Exception
                    ' Could not resolve this name - just as good as a ping failure
                    FileLoggingObject.WriteDebugEvent("Server was not found")
                    FileLoggingObject.WriteDebugEvent("The actual error returned was " & ex.Message)
                End Try
            Loop Until PingAttempt = 3 Or ServerUp

            PingAttempt = 0

            If Not ServerUp Then
                Index += 1
            End If
        Loop Until ServerUp Or Index = ServerNames.Length

            If ServerUp Then
            Return ServerNames(Index)
            Else
                Return Constants.DEFAULTSTRINGVALUE
            End If
    End Function

    Private Sub DoStartup()
        FileLoggingObject.LogType = LOGGING_TYPE.LOGFILE

        Debug.Print(FileLoggingObject.Filename)

        Try
            My.Settings.Reset()
        Catch

        End Try

        Try
            If Not IO.Directory.Exists(m_AppDataPath) Then
                FileLoggingObject.WriteInformationEvent("Attempting to create directory: " & m_AppDataPath)
                IO.Directory.CreateDirectory(m_AppDataPath)
            End If
        Catch ex1 As Exception
            FileLoggingObject.WriteErrorEvent("Create directory failed.  The error was:")
            FileLoggingObject.WriteErrorEvent(ex1.Message)
            m_AppDataPath = My.Computer.FileSystem.SpecialDirectories.MyDocuments & "\CADS\4.0"
            Try
                If Not IO.Directory.Exists(m_AppDataPath) Then
                    FileLoggingObject.WriteInformationEvent("Attempting to create directory: " & m_AppDataPath)
                    IO.Directory.CreateDirectory(m_AppDataPath)
                End If
            Catch ex2 As Exception
                FileLoggingObject.WriteErrorEvent("Create directory failed.  The error was:")
                FileLoggingObject.WriteErrorEvent(ex2.Message)
                FileLoggingObject.WriteErrorEvent("This application cannot continue.")
                If Not m_RunningInNonInteractiveMode Then
                    MsgBox("There have been multiple errors whilst attempting to create a working directory for the application.  Review filesystem security and the Application logfile for further information.", MsgBoxStyle.Critical, "Application Error")
                End If
                m_CADSConfigFileNotFound = True
                ' Error 5 <---- required?
            End Try
        End Try

        Dim CommandString As String = Command.ToString.ToLower

        If CommandString.Length = 0 Then FileLoggingObject.LogLevel = LOGGING_LEVEL.ERRORS
        If CommandString.Contains("-debug") Then FileLoggingObject.LogLevel = FileLoggingObject.LogLevel Or LOGGING_LEVEL.DEBUGGING
        If CommandString.Contains("-info") Then FileLoggingObject.LogLevel = FileLoggingObject.LogLevel Or LOGGING_LEVEL.INFORMATION
        If CommandString.Contains("-warn") Then FileLoggingObject.LogLevel = FileLoggingObject.LogLevel Or LOGGING_LEVEL.WARNING
        If CommandString.Contains("-error") Then FileLoggingObject.LogLevel = FileLoggingObject.LogLevel Or LOGGING_LEVEL.ERRORS

#If DEBUG Then
        FileLoggingObject.LogLevel = FileLoggingObject.LogLevel Or LOGGING_LEVEL.DEBUGGING
#End If
        FileLoggingObject.WriteInformationEvent("------------------------------------------------------------------")
        FileLoggingObject.WriteInformationEvent("----------------------------Startup-------------------------------")
        FileLoggingObject.WriteInformationEvent("Logging Level set to " & FileLoggingObject.LogLevel)

        If Not IO.File.Exists(m_AppDataPath & "\cads.config") Then
            If RunningInNonInteractiveMode Then
                FileLoggingObject.WriteErrorEvent("Application is running Non-Interactively, but cannot locate cads.config!")
                FileLoggingObject.WriteErrorEvent("Run this application at least once interactively.")
                FileLoggingObject.WriteErrorEvent("Logon will now be caused to fail.")
                m_CADSConfigFileNotFound = True
            Else
                Dim ofdMain As New Windows.Forms.OpenFileDialog
                Dim SelectedPath As String = ""

                ofdMain.InitialDirectory = My.Computer.FileSystem.SpecialDirectories.ProgramFiles
                ofdMain.CheckPathExists = True
                ofdMain.Title = "Browse for cads.config"
                ofdMain.DefaultExt = "*.config"
                Dim dr As Windows.Forms.DialogResult = ofdMain.ShowDialog

                If dr = Windows.Forms.DialogResult.OK Then
                    SelectedPath = ofdMain.FileName.ToLower.Replace("\cads.config", "")
                    If IO.File.Exists(SelectedPath & "\cads.config") Then
                        FileLoggingObject.WriteDebugEvent("Found cads.config at " & SelectedPath)
                        m_CADSConfigFileNotFound = False
                        m_ConfigFilenameAndPath = SelectedPath & "\cads.config"
                        Try
                            For Each Filename As String In My.Computer.FileSystem.GetFiles(SelectedPath, FileIO.SearchOption.SearchTopLevelOnly, "*.config")
                                Dim ShortFilename As String = Filename.Substring(Filename.LastIndexOf("\") + 1)
                                My.Computer.FileSystem.CopyFile(Filename, m_AppDataPath & "\" & ShortFilename, True)
                            Next

                            'IO.File.Copy(SelectedPath & "\cads.config", m_AppDataPath & "\cads.config")
                            'IO.File.Copy(SelectedPath & "\import.config", m_AppDataPath & "\import.config")
                            m_ConfigFilenameAndPath = m_AppDataPath & "\cads.config"
                            m_ConfigFileSourceLocation = SelectedPath  'm_AppDataPath
                        Catch ex As Exception
                            FileLoggingObject.WriteErrorEvent("Could not copy cads.config to " & m_AppDataPath & ".  The error message returned is shown on the next line(s).")
                            FileLoggingObject.WriteErrorEvent(ex.Message)
                            m_CADSConfigFileNotFound = True
                        End Try
                    End If
                Else
                    m_CADSConfigFileNotFound = True
                End If
            End If
        Else
            ' File does exist
            'Read the path where I can get an updated copy of this file
            m_ConfigFilenameAndPath = m_AppDataPath & "\cads.config"
            Dim SourcePath As String = LoadConfigSetting("SystemSettings", "ConfigFileLocation")

            If (SourcePath <> Constants.DEFAULTSTRINGVALUE) And SourcePath <> "" Then

                Try
                    IO.File.Copy(SourcePath & "\cads.config", m_AppDataPath & "\cads.config", True)
                    FileLoggingObject.WriteDebugEvent("Successfully copied cads.config from '" & SourcePath & "' to '" & m_AppDataPath & "\cads.config" & "'")
                    m_CADSConfigFileNotFound = False
                    m_ConfigFileSourceLocation = SourcePath
                Catch ex As Exception
                    FileLoggingObject.WriteErrorEvent("Could not copy cads.config from '" & SourcePath & "' to '" & m_AppDataPath & "\cads.config" & "'")
                    FileLoggingObject.WriteErrorEvent("The error message was: " & LastStatus.LastException.Message)
                    FileLoggingObject.WriteErrorEvent("Switching to read from '" & SourcePath & "'")

                    m_ConfigFilenameAndPath = SourcePath & "\cads.config"

                    Dim TempFilePath As String = LoadConfigSetting("SystemSettings", "ConfigFileLocation")

                    If TempFilePath = Constants.DEFAULTSTRINGVALUE Then
                        FileLoggingObject.WriteErrorEvent("Cannot read cads.config from '" & SourcePath & "'")
                        FileLoggingObject.WriteErrorEvent("The error message was: " & LastStatus.LastException.Message)
                        m_CADSConfigFileNotFound = True
                    Else
                        m_ConfigFilenameAndPath = TempFilePath & "\cads.config"
                        m_CADSConfigFileNotFound = False
                    End If
                End Try
            Else
                ' BAD!  could not find the correct location to the config file!
                FileLoggingObject.WriteErrorEvent("Could not read ConfigFileLocation from config file '" & SourcePath & "'")
                MsgBox("Could not read ConfigFileLocation from config file '" & m_AppDataPath & "\cads.config" & "'", MsgBoxStyle.Critical + MsgBoxStyle.OkOnly)
                ' IO.File.Copy(SourcePath & "\cads.config", m_AppDataPath & "\cads.config", True)
                Dim ofdMain As New Windows.Forms.OpenFileDialog
                Dim SelectedPath As String = ""

                ofdMain.InitialDirectory = My.Computer.FileSystem.SpecialDirectories.ProgramFiles
                ofdMain.CheckPathExists = True
                ofdMain.Title = "Browse for cads.config"
                ofdMain.DefaultExt = "*.config"
                Dim dr As Windows.Forms.DialogResult = ofdMain.ShowDialog

                If dr = Windows.Forms.DialogResult.OK Then
                    SelectedPath = ofdMain.FileName.ToLower.Replace("\cads.config", "")
                    If IO.File.Exists(SelectedPath & "\cads.config") Then
                        m_ConfigFilenameAndPath = SelectedPath & "\cads.config"
                        m_CADSConfigFileNotFound = False
                        m_ConfigFileSourceLocation = SelectedPath
                    Else
                        ' This case should not happen.  The Open file dialog should check for the file
                        ' before we get to this point
                        m_CADSConfigFileNotFound = True
                    End If
                End If
            End If
        End If

    End Sub

    Public Shared Function GetNetworkFolders(ByVal oFolderBrowserDialog As Windows.Forms.FolderBrowserDialog) As String
        '======= Get type of Folder Dialog bog
        Dim type As Type = oFolderBrowserDialog.[GetType]
        '======== Get Fieldinfo for rootfolder.
        Dim fieldInfo As Reflection.FieldInfo = type.GetField("rootFolder", BindingFlags.NonPublic Or BindingFlags.Instance)
        '========= Now set the value for Folder Dialog using DirectCast
        '=== 18 = Network Neighborhood is the root
        fieldInfo.SetValue(oFolderBrowserDialog, DirectCast(18, Environment.SpecialFolder))
        '==== if user click on Ok, then it will return the selected folder.
        '===== otherwise return the blank string.
        If oFolderBrowserDialog.ShowDialog() = Windows.Forms.DialogResult.OK Then
            Return oFolderBrowserDialog.SelectedPath
        Else
            Return Constants.DEFAULTSTRINGVALUE
        End If
    End Function

    Public Function ConvertGUIDToString(ByRef GUIDString) As String
        Dim ReturnString As String = ""

        For Count = 0 To GUIDString.Length - 1
            ReturnString = ReturnString + Hex(GUIDString(Count))
        Next

        Return ReturnString
    End Function

#End Region

#Region " Directory "

    ''' <summary>
    ''' Returns a list of User Attributes
    ''' </summary>
    ''' <returns>The Attribute Collection</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function GetADUserAttributeList() As Collections.Specialized.OrderedDictionary
        Dim SearchRoot As New DirectoryEntry(InteractiveUserActiveDirectoryPath, Nothing, Nothing, AuthenticationTypes.Secure)
        Dim AttributeCollection As New Collections.Specialized.OrderedDictionary
        ' TODO:  Consider if we should return a failure if the path does not exist
        Using SearchRoot
            Dim ds As New DirectorySearcher("objectClass=user")

            ds.SizeLimit = 1

            Dim sr As SearchResult = ds.FindOne

            If sr IsNot Nothing Then
                Using User As DirectoryEntry = sr.GetDirectoryEntry()
                    Using Schema As DirectoryEntry = User.SchemaEntry
                        Dim t As Type = Schema.NativeObject.[GetType]()

                        Dim [optional] As Object = t.InvokeMember("OptionalProperties", BindingFlags.[Public] Or BindingFlags.GetProperty, Nothing, Schema.NativeObject, Nothing)
                        Dim count As Integer = 0
                        If TypeOf [optional] Is System.Collections.ICollection Then
                            For Each s As String In DirectCast([optional], System.Collections.ICollection)
                                AttributeCollection.Add(s.ToString, s.ToString)
                            Next
                        End If

                        Dim Mand As Object = t.InvokeMember("MandatoryProperties", BindingFlags.[Public] Or BindingFlags.GetProperty, Nothing, Schema.NativeObject, Nothing)
                        If TypeOf Mand Is System.Collections.ICollection Then
                            For Each s As String In DirectCast(Mand, System.Collections.ICollection)
                                AttributeCollection.Add(s.ToString, s.ToString)
                            Next
                        End If
                    End Using
                End Using
            End If
        End Using

        Return AttributeCollection
    End Function

    ''' <summary>
    ''' Connect to the Directory with the Connection parameters
    ''' </summary>
    ''' <param name="ADPathToConnect"></param>
    ''' <returns>DirectoryEntry connected to the ADPath</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function GetDirectoryConnection(ByVal ADPathToConnect As String) As DirectoryEntry
        Try
            Dim Connection As New DirectoryServices.DirectoryEntry(ADPathToConnect, TargetDirectoryConnectionUsername, TargetDirectoryConnectionPassword, AuthenticationTypes.ServerBind)

            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = SUCCESS

            Return Connection
        Catch ex As Exception
            LastStatus.LastException = ex

            Select Case ex.Message.Trim
                Case "The server is not operational."
                    LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.SERVER_NOT_FOUND)
                Case "Logon failure: unknown user name or bad password."
                    LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.SECURITY, ERROR_SECURITY.AUTHENTICATION_FAILURE)
                Case "A local error has occurred."
                    LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.DIRECTORY_ERROR)
                Case Else
                    LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.DIRECTORY_ERROR)
            End Select

            Return Nothing
        End Try
    End Function

    ''' <summary>
    ''' Check if the given Directory path exists
    ''' </summary>
    ''' <param name="DirectoryPath">Fully qualified LDAP Path in the form 'LDAP://[Server:Port/]dc=Name,dc=COM'</param>
    ''' <returns>Boolean value indicating the result of the search</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function LDAPObjectExists(ByVal DirectoryPath As String) As Boolean
        Dim oSearcher As New DirectorySearcher()

        Try
            With oSearcher
                .SearchRoot = New DirectoryEntry(DirectoryPath)
                .SearchScope = SearchScope.Subtree
                .Filter = "(objectClass=*)"
                .FindOne()
            End With
            oSearcher = Nothing

            LastStatus.CADS_ERRORCODE = SUCCESS
            LastStatus.LastException = Nothing
            'Settings.LastError = ApplicationStatus
            Return True
        Catch ex As Exception
            ' Nothing required here.  An incorrect path will result in an exception which is ok.
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = SUCCESS
            Return False
        End Try

    End Function

    ''' <summary>
    ''' Checks if the given Object name exists in the Directory
    ''' </summary>
    ''' <param name="distinguishedName">An object name to look for</param>
    ''' <returns>Boolean value indicating the result of the search</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function ObjectExists(ByVal distinguishedName As String) As Boolean
        Try
            If distinguishedName.StartsWith("LDAP://") Then
                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = Nothing
                Return DirectoryEntry.Exists(distinguishedName)
            Else
                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = Nothing
                Return DirectoryEntry.Exists(CurrentDirectoryServer & distinguishedName)
            End If

        Catch ex As Exception
            Select Case ex.Message.ToString.Trim
                Case "A referral was returned from the server."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.REFERRAL_RETURNED
                    LastStatus.LastException = ex
                    Return False
                Case "A local error has occurred."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.DIRECTORY_ERROR
                    LastStatus.LastException = ex
                    Return False
                Case Else
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.AUTHENTICATION_FAILURE
                    LastStatus.LastException = ex
                    Return False
            End Select
        End Try

    End Function

    Public Function UserExists(ByVal distinguishedName As String, ByVal CommonName As String) As Boolean
        Dim de As DirectoryEntry
        Dim deSearch As DirectorySearcher
        Dim Result As Boolean

        Try
            de = New DirectoryEntry("LDAP://" & CurrentDirectoryServer & distinguishedName, TargetDirectoryConnectionUsername, TargetDirectoryConnectionPassword, AuthenticationTypes.ServerBind)
            deSearch = New DirectorySearcher(de)
            deSearch.Filter = "(&(ObjectClass=user)(cn=" & CommonName.Trim & "))"

            Dim Results As SearchResult = deSearch.FindOne()
            Result = Results.Path <> ""
            de.Close()
        Catch ex As Exception
            'Produce a new error code
            LastStatus.Clear()
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.UNSPECIFIED, ERROR_UNSPECIFIED.OTHER)
        End Try

        deSearch = Nothing
        de = Nothing

        'Produce a new error code
        LastStatus.Clear()
        LastStatus.CADS_ERRORCODE = ERRORTYPE.SUCCESS
        Return Result
    End Function

    Public Function CreateUser(ByVal TargetOUDN As String, ByVal UserCN As String) As DirectoryEntry
        Dim NewUser As DirectoryEntry = Nothing
        Dim LDAPServerNameAndPort As String
        Dim CN As String

        ' Ensure prefix for the Server is correct
        If Not CurrentDirectoryServer.StartsWith("LDAP://") Then
            LDAPServerNameAndPort = "LDAP://" & CurrentDirectoryServer
        Else
            LDAPServerNameAndPort = CurrentDirectoryServer
        End If

        ' Ensure Suffix of the Server is correct
        If Not CurrentDirectoryServer.EndsWith("/") Then
            LDAPServerNameAndPort = CurrentDirectoryServer & "/"
        Else
            LDAPServerNameAndPort = CurrentDirectoryServer
        End If

        ' Ensure CN prefix is correct
        If Not UserCN.StartsWith("CN=") Then
            CN = "CN=" & UserCN
        Else
            CN = UserCN
        End If

        Try
            'Bind to the directory object and create user
            DirectoryConnection = New DirectoryEntry(LDAPServerNameAndPort & TargetOUDN, TargetDirectoryConnectionUsername, TargetDirectoryConnectionPassword, AuthenticationTypes.ServerBind)
            NewUser = DirectoryConnection.Children.Add(UserCN, "User")
            NewUser.CommitChanges()

            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = SUCCESS
            LastStatus.LastException = Nothing
        Catch ex As Exception
            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.CREATE_USER_ERROR
            LastStatus.LastException = ex
        End Try

        Return NewUser

    End Function

    ''' <summary>
    ''' Check the given Username and Password against the given AD Server
    ''' </summary>
    ''' <param name="DirectoryPath">Fully qualified LDAP Path in the form 'LDAP://[Server:Port/]dc=Name,dc=COM'</param>
    ''' <param name="DomainAndUsername">The Username to check (including Domain Name)</param>
    ''' <param name="Password">The Password to check</param>
    ''' <returns>Boolean value indicating the result</returns>
    ''' <remarks></remarks>
    Public Function CheckADPassword(ByVal DirectoryPath As String, ByVal DomainAndUsername As String, ByVal Password As String) As Boolean
        Dim de As DirectoryEntry = New DirectoryEntry(DirectoryPath, DomainAndUsername, Password)

        Try
            'Bind to the native AdsObject to force authentication.
            Dim obj As Object = de.NativeObject
            Try
                Dim Search As DirectorySearcher = New DirectorySearcher(de)

                Search.Filter = "(sAMAccountName=" & DomainAndUsername.Substring(DomainAndUsername.IndexOf("\") + 1) & ")"
                Search.PropertiesToLoad.Add("cn")
                Dim SearchResult As SearchResult = Search.FindOne()

                If (SearchResult Is Nothing) Then
                    LastStatus.CADS_ERRORCODE = SUCCESS
                    LastStatus.LastException = Nothing
                    de.Close()
                    Return False
                End If

                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = Nothing
                Return True
            Catch ex As Exception
                ' Nothing required here.  An incorrect path will result in an exception which is ok.
                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = ex
                de.Close()
                Return False
            End Try
        Catch ex As Exception
            Select Case ex.Message.ToString.Trim
                Case "A referral was returned from the server."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.REFERRAL_RETURNED
                    LastStatus.LastException = ex
                    Return False
                Case "A local error has occurred."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.DIRECTORY_ERROR
                    LastStatus.LastException = ex
                Case Else
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.AUTHENTICATION_FAILURE
                    LastStatus.LastException = ex
                    Return False
            End Select
        End Try

    End Function

    ''' <summary>
    ''' Check the given Username and Password against the given ADAM Server
    ''' </summary>
    ''' <param name="DirectoryPath">Fully qualified LDAP Path in the form 'LDAP://[Server:Port/]dc=Name,dc=COM'</param>
    ''' <param name="Username">The Username to check</param>
    ''' <param name="Password">The Password to check</param>
    ''' <returns>Boolean value indicating the result</returns>
    ''' <remarks></remarks>
    Public Function CheckADAMPassword(ByVal DirectoryPath As String, ByVal Username As String, ByVal Password As String) As Boolean
        Dim de As DirectoryEntry = New DirectoryEntry(DirectoryPath, Username, Password, AuthenticationTypes.ServerBind)

        Try
            'Bind to the native AdsObject to force authentication.
            Dim obj As Object = de.NativeObject
            Try
                Dim Search As DirectorySearcher = New DirectorySearcher(de)

                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = Nothing
                de.Close()

                Return True
            Catch ex As Exception
                ' Nothing required here.  An incorrect path will result in an exception which is ok.
                LastStatus.CADS_ERRORCODE = SUCCESS
                LastStatus.LastException = ex
                de.Close()

                Return False
            End Try
        Catch ex As Exception
            de.Close()
            Select Case ex.Message.ToString.Trim
                Case "A referral was returned from the server."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.REFERRAL_RETURNED
                    LastStatus.LastException = ex

                    Return False
                Case "A local error has occurred."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.DIRECTORY_ERROR
                    LastStatus.LastException = ex

                    Return False
                Case "Logon failure: unknown user name or bad password."
                    LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.AUTHENTICATION_FAILURE
                    LastStatus.LastException = ex

                    Return False
                Case Else
                    LastStatus.CADS_ERRORCODE = ERROR_SECURITY.GENERIC_SECURITY_ERROR
                    LastStatus.LastException = ex

                    Return False
            End Select

        End Try

    End Function

    ''' <summary>
    ''' Creates a Organizational unit to callers criteria
    ''' </summary>
    ''' <param name="NewOUDistinguishedName">The path of the new OU</param>
    ''' <returns>CADS4 ERROR_CODE</returns>
    ''' <remarks>V1.1 D. Robinson</remarks>
    Public Function CreateOU(ByVal NewOUDistinguishedName As String) As DirectoryEntry
        Dim OU As DirectoryEntry = Nothing ' Organizational Unit.

        Try
            Dim OUName As String           ' Organizational Unit Name.
            Dim Path As String             ' Binding path.

            ' Construct the binding string.
            Path = NewOUDistinguishedName

            If Not NewOUDistinguishedName.StartsWith("LDAP://") Then
                OUName = Path
            Else
                ' Specify Organizational Unit.
                Dim i As Integer = Path.IndexOf("//", 0)
                OUName = Path.Remove(0, i + 2)
                Dim j As Integer = OUName.IndexOf("/", 0)
                OUName = OUName.Remove(j)

                'Specify the path.
                Path = Path.Remove(i + 2, j + 1)
            End If

            DirectoryConnection = New DirectoryEntry(Path, TargetDirectoryConnectionUsername, TargetDirectoryConnectionPassword, AuthenticationTypes.ServerBind)
            DirectoryConnection.RefreshCache()
            OU = DirectoryConnection.Children.Add(OUName, "OrganizationalUnit")

            OU.CommitChanges()
            OU.Close()
            OU = Nothing

            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = SUCCESS
            LastStatus.LastException = Nothing

        Catch ex As Exception
            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = ERROR_DIRECTORY.CREATE_OU_ERROR
            LastStatus.LastException = ex
        End Try

        Return OU

    End Function


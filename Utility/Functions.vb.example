    ''' <summary>
    ''' Returns the list of Active Directory sites
    ''' </summary>
    ''' <returns>StringCollection of AD Site names</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function GetADSitelist() As Collections.Specialized.OrderedDictionary
        Dim ADSitelist As New Collections.Specialized.OrderedDictionary
        Dim RootDSE As New Object
        Dim ConfigurationNC As String
        Dim SitesContainerName As String

        RootDSE = GetObject("LDAP://RootDSE")
        ConfigurationNC = RootDSE.Get("configurationNamingContext")

        SitesContainerName = "LDAP://cn=Sites," & ConfigurationNC

        Dim oSearcher As New DirectorySearcher()

        Try
            With oSearcher
                .SearchRoot = New DirectoryEntry(SitesContainerName)
                .SearchScope = SearchScope.Subtree
                .Filter = "(objectClass=site)"
            End With

        Catch ex As Exception
            ' If we can't get the list of sites, we are in trouble.
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.DIRECTORY_ERROR)
        End Try

        For Each Site As SearchResult In oSearcher.FindAll
            ADSitelist.Add(Site.Properties("Name")(0).ToString, Site.Properties("Name")(0).ToString)
        Next

        LastStatus.CADS_ERRORCODE = SUCCESS

        Return ADSitelist
    End Function

    ''' <summary>
    ''' Retrives the list of users from the current user's AD
    ''' </summary>
    ''' <param name="RootDN">The Root distinguished name to search in the form "OU=Users,OU=Unit"</param>
    ''' <returns>Collection of strings</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function GetADUserList(Optional ByVal RootDN As String = "") As Collections.Specialized.OrderedDictionary
        Dim ADUserList As New Collections.Specialized.OrderedDictionary
        Dim RootDSE As New Object
        Dim DefaultNC As String
        Dim UserContainerName As String

        RootDSE = GetObject("LDAP://RootDSE")
        DefaultNC = RootDSE.Get("defaultNamingContext")

        If RootDN <> "" Then
            UserContainerName = "LDAP://" & RootDN & "," & DefaultNC
        Else
            UserContainerName = "LDAP://" & DefaultNC
        End If

        Dim oSearcher As New DirectorySearcher()

        Try
            With oSearcher
                .SearchRoot = New DirectoryEntry(UserContainerName)
                .SearchScope = SearchScope.Subtree
                .Filter = "(objectClass=user)"
            End With

        Catch ex As Exception
            ' If we can't get the list of users, we are in trouble.
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.DIRECTORY_ERROR)
        End Try

        For Each User As SearchResult In oSearcher.FindAll
            Dim Username As String = User.Properties("samAccountName")(0).ToString
            If Not Username.EndsWith("$") Then ' Don't show Computernames
                ADUserList.Add(User.Properties("samAccountName")(0).ToString, User.Properties("samAccountName")(0).ToString)
            End If
        Next

        LastStatus.CADS_ERRORCODE = SUCCESS

        Return ADUserList
    End Function

    ''' <summary>
    ''' Disables the given User DN
    ''' </summary>
    ''' <param name="UserDistinguishedName">The distinguishedName of the User to disable</param>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Sub DisableUser(ByVal UserDistinguishedName As String)
        Try
            Dim User As New DirectoryEntry(UserDistinguishedName)
            Dim Value As Int32 = User.Properties("userAccountControl").Value

            User.Properties("userAccountControl").Value = Value Or 2

            User.CommitChanges()
            User.Close()
            LastStatus.CADS_ERRORCODE = SUCCESS

        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = (ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.AUTHENTICATION_FAILURE))

        End Try

    End Sub

    ''' <summary>
    ''' Enables the given User DN
    ''' </summary>
    ''' <param name="UserDistinguishedName">The distinguishedName of the User to enable</param>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Sub EnableUser(ByVal UserDistinguishedName As String)
        Try
            Dim User As New DirectoryEntry(UserDistinguishedName)
            Dim Value As Int32 = User.Properties("userAccountControl").Value

            User.Properties("userAccountControl").Value = Value And 2

            User.CommitChanges()
            User.Close()
            LastStatus.CADS_ERRORCODE = SUCCESS

        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.AUTHENTICATION_FAILURE)

        End Try
    End Sub

    ''' <summary>
    ''' Sets the manager property of the given User
    ''' </summary>
    ''' <param name="UserDistinguishedName">The distinguishedName of the User to modify</param>
    ''' <param name="ManagerDistinguishedName">The distinguishedName of the Manager User</param>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Sub SetManager(ByVal UserDistinguishedName As String, ByVal ManagerDistinguishedName As String)
        Dim User As DirectoryEntry

        If TargetDirectoryConnectionUsername = "" And (Not ConnectAnonymously) Then
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.NO_USERNAME)

        Else
            Try
                If ConnectAnonymously Then
                    User = New DirectoryEntry("LDAP://" & CurrentDirectoryServer & UserDistinguishedName)
                Else
                    User = New DirectoryEntry("LDAP://" & CurrentDirectoryServer & UserDistinguishedName, TargetDirectoryConnectionUsername, TargetDirectoryConnectionPassword, AuthenticationTypes.ServerBind)
                End If

                User.Properties("manager").Value = ManagerDistinguishedName

                User.CommitChanges()
                User.Close()
                User = Nothing
            Catch ex As Exception
                Select Case ex.Message.ToString.Trim
                    Case "A referral was returned from the server."
                        FileLoggingObject.WriteErrorEvent("Error 1 in SetManager(). Debugging information follows:")
                        FileLoggingObject.WriteErrorEvent("UserDistinguishedName   : " & UserDistinguishedName)
                        FileLoggingObject.WriteErrorEvent("ManagerDistinguishedName: " & ManagerDistinguishedName)
                        FileLoggingObject.WriteErrorEvent("The line(s) between the asterisks contain the Exception message.")
                        FileLoggingObject.WriteErrorEvent("************************************************************************")
                        FileLoggingObject.WriteErrorEvent(ex.Message)
                        FileLoggingObject.WriteErrorEvent("************************************************************************")
                        LastStatus.LastException = ex
                        LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.SECURITY, ERROR_DIRECTORY.REFERRAL_RETURNED)

                    Case "A local error has occurred."
                        FileLoggingObject.WriteErrorEvent("Error 2 in SetManager(). Debugging information follows:")
                        FileLoggingObject.WriteErrorEvent("UserDistinguishedName   : " & UserDistinguishedName)
                        FileLoggingObject.WriteErrorEvent("ManagerDistinguishedName: " & ManagerDistinguishedName)
                        FileLoggingObject.WriteErrorEvent("The line(s) between the asterisks contain the Exception message.")
                        FileLoggingObject.WriteErrorEvent("************************************************************************")
                        FileLoggingObject.WriteErrorEvent(ex.Message)
                        FileLoggingObject.WriteErrorEvent("************************************************************************")
                        LastStatus.LastException = ex
                        LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.DIRECTORY_ERROR)

                    Case "Logon failure: unknown user name or bad password."
                        FileLoggingObject.WriteErrorEvent("Error 3 in SetManager(). Debugging information follows:")
                        FileLoggingObject.WriteErrorEvent("UserDistinguishedName   : " & UserDistinguishedName)
                        FileLoggingObject.WriteErrorEvent("ManagerDistinguishedName: " & ManagerDistinguishedName)
                        FileLoggingObject.WriteErrorEvent("The line(s) between the asterisks contain the Exception message.")
                        FileLoggingObject.WriteErrorEvent("************************************************************************")
                        FileLoggingObject.WriteErrorEvent(ex.Message)
                        FileLoggingObject.WriteErrorEvent("************************************************************************")
                        LastStatus.LastException = ex
                        LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.SECURITY, ERROR_SECURITY.AUTHENTICATION_FAILURE)

                    Case Else
                        FileLoggingObject.WriteErrorEvent("Error 4 in SetManager(). Debugging information follows:")
                        FileLoggingObject.WriteErrorEvent("UserDistinguishedName   : " & UserDistinguishedName)
                        FileLoggingObject.WriteErrorEvent("ManagerDistinguishedName: " & ManagerDistinguishedName)
                        FileLoggingObject.WriteErrorEvent("The line(s) between the asterisks contain the Exception message.")
                        FileLoggingObject.WriteErrorEvent("************************************************************************")
                        FileLoggingObject.WriteErrorEvent(ex.Message)
                        FileLoggingObject.WriteErrorEvent("************************************************************************")
                        LastStatus.LastException = ex
                        LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.SECURITY, ERROR_SECURITY.AUTHENTICATION_FAILURE)

                End Select

            End Try
        End If
    End Sub

    ''' <summary>
    ''' Moves the User to the destination location
    ''' </summary>
    ''' <param name="UserDistinguishedName">The User distinguishedName</param>
    ''' <param name="NewOUDistinguishedName">Destination OU distinguishedName</param>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Sub MoveUser(ByVal UserDistinguishedName As String, ByVal NewOUDistinguishedName As String)

        'If UserDistinguishedName.ToLower.StartsWith("ldap://" & CurrentDirectoryServer) Then
        '    UserDistinguishedName = UserDistinguishedName.Substring(7 + CurrentDirectoryServer.Length)
        'End If

        'If NewOUDistinguishedName.ToLower.StartsWith("ldap://" & CurrentDirectoryServer) Then
        '    NewOUDistinguishedName = NewOUDistinguishedName.Substring(7 + CurrentDirectoryServer.Length)
        'End If

        Try
            'Dim User As New DirectoryEntry(CurrentDirectoryServer & UserDistinguishedName)
            Dim User As New DirectoryEntry(UserDistinguishedName)
            'Dim DestinationOU As DirectoryEntry = New DirectoryEntry(CurrentDirectoryServer & NewOUDistinguishedName)
            Dim DestinationOU As DirectoryEntry = New DirectoryEntry(NewOUDistinguishedName)

            User.MoveTo(DestinationOU)

            User.Close()
            DestinationOU.Close()
            LastStatus.CADS_ERRORCODE = SUCCESS

        Catch ex As Exception
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.OTHER)
            LastStatus.LastException = ex
            FileLoggingObject.WriteErrorEvent("Could not move user object.  The error returned is contained in the following line(s)")
            FileLoggingObject.WriteErrorEvent(ex.Message)
        End Try

    End Sub

    Public Sub SetCustomProperties(ByVal DistinguishedName As String, ByVal PropertyStringCollection As Collections.Specialized.StringCollection)
        Dim User As DirectoryEntry
        Dim LDAPPrefix As String = "LDAP://"

        Debug.Print("Inside SetCustomProperties...")

        If CurrentDirectoryServer.StartsWith("LDAP://") Then LDAPPrefix = ""

        Debug.Print("   Prefix  : " & LDAPPrefix)
        Debug.Print("   Server  : " & CurrentDirectoryServer)
        Debug.Print("   DN      : " & DistinguishedName)
        Debug.Print("   Username: "REDACTED"   Password: "REDACTED"" And (Not ConnectAnonymously) Then
                        LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.NO_USERNAME)
                    Else
                        If ConnectAnonymously Then
                            Debug.Print("Connecting to Directory (anon)...")
                            User = New DirectoryEntry(CurrentDirectoryServer & DistinguishedName)
                        Else
                            Debug.Print("Connecting to Directory (user specified)...")
                            User = New DirectoryEntry(LDAPPrefix & CurrentDirectoryServer & DistinguishedName, TargetDirectoryConnectionUsername, TargetDirectoryConnectionPassword, AuthenticationTypes.ServerBind)
                        End If

                        User.RefreshCache()
                        For Each UserProperty As String In PropertyStringCollection
                            Debug.Print("..." & UserProperty)
                            User.Properties("wbemPath").Add(UserProperty)
                        Next

                        User.CommitChanges()
                        User.Close()
                        User = Nothing
                        LastStatus.CADS_ERRORCODE = SUCCESS
                    End If
                Else
                    LastStatus.CADS_ERRORCODE = ErrorResult(UNSPECIFIED, ERROR_UNSPECIFIED.SYNTAX_ERROR)
                End If
            Catch ex As Exception
                LastStatus.LastException = ex
                LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.OTHER)
            End Try
        Else
            LastStatus.CADS_ERRORCODE = ErrorResult(UNSPECIFIED, ERROR_UNSPECIFIED.WRONG_OBJECT_TYPE)
        End If

    End Sub

    Public Function GetCustomProperties(ByVal DistinguishedName As String) As Collections.Specialized.StringCollection
        Dim User As DirectoryEntry
        Dim PropertyStringCollection As New Collections.Specialized.StringCollection

        Try
            If DistinguishedName.Length > 0 Then
                If TargetDirectoryConnectionUsername = "" And (Not ConnectAnonymously) Then
                    LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.NO_USERNAME)

                    Return PropertyStringCollection
                Else
                    If ConnectAnonymously Then
                        User = New DirectoryEntry(CurrentDirectoryServer & DistinguishedName)
                    Else
                        User = New DirectoryEntry(CurrentDirectoryServer & DistinguishedName, TargetDirectoryConnectionUsername, TargetDirectoryConnectionPassword, AuthenticationTypes.ServerBind)
                    End If

                    User.RefreshCache()

                    Dim ValueCollection As PropertyValueCollection = User.Properties("wbemPath")
                    Dim en As IEnumerator

                    en = ValueCollection.GetEnumerator

                    While en.MoveNext
                        If en.Current IsNot Nothing Then
                            PropertyStringCollection.Add(en.Current.ToString)
                        End If
                    End While

                    User.Close()
                    LastStatus.CADS_ERRORCODE = SUCCESS

                    Return PropertyStringCollection
                End If
            Else
                LastStatus.CADS_ERRORCODE = ErrorResult(UNSPECIFIED, ERROR_UNSPECIFIED.SYNTAX_ERROR)

                Return PropertyStringCollection
            End If

        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.DIRECTORY, ERROR_DIRECTORY.OTHER)

            Return PropertyStringCollection
        End Try
    End Function

    Public Function GetLookupCollection(ByVal LDAPServerAndPort As String, _
                                        ByVal ListName As String, _
                                        ByVal ReturnDescriptionOnly As Boolean, _
                                        ByVal DirectoryConfigurationRoot As String, _
                                        ByVal DirectoryConnectionUsername As String, _
                                        ByVal DirectoryConnectionPassword As String) As Collections.Specialized.OrderedDictionary
        Dim SiteCollection = New Collections.Specialized.OrderedDictionary

        FileLoggingObject.WriteEvent("Inside GetLookupCollection", LOGGING_LEVEL.DEBUGGING)

        If Not LDAPServerAndPort.StartsWith("LDAP://") Then
            LDAPServerAndPort = "LDAP://" & LDAPServerAndPort
        End If

        If Not LDAPServerAndPort.EndsWith("/") Then
            LDAPServerAndPort &= "/"
        End If

        FileLoggingObject.WriteEvent("ListName=" & ListName, LOGGING_LEVEL.DEBUGGING)
        FileLoggingObject.WriteEvent("LDAPServerAndPort=" & LDAPServerAndPort, LOGGING_LEVEL.DEBUGGING)

        If CurrentDirectoryServer & "" <> "" Then
            If DirectoryConfigurationRoot.StartsWith("LDAP://") Then DirectoryConfigurationRoot = Replace(DirectoryConfigurationRoot, "LDAP://", "")
            If DirectoryConfigurationRoot.StartsWith(CurrentDirectoryServer) Then DirectoryConfigurationRoot = Replace(DirectoryConfigurationRoot, CurrentDirectoryServer, "")
        End If

        FileLoggingObject.WriteEvent("DirectoryConfigurationRoot=" & DirectoryConfigurationRoot, LOGGING_LEVEL.DEBUGGING)

        ' Create full directory path
        Dim FullRootPath As String = LDAPServerAndPort & "OU=" & ListName & "," & DirectoryConfigurationRoot

        FileLoggingObject.WriteEvent("FullRootPath=" & FullRootPath, LOGGING_LEVEL.DEBUGGING)
        FileLoggingObject.WriteEvent("DirectoryConnectionUsername="REDACTED"debug") Then
            FileLoggingObject.WriteEvent("DirectoryConnectionPassword="REDACTED"Bind to the directory
            Dim de As DirectoryEntry = New DirectoryEntry(FullRootPath, DirectoryConnectionUsername, DirectoryConnectionPassword, AuthenticationTypes.ServerBind)

            'Create search object
            Dim Search As DirectorySearcher = New DirectorySearcher(de)

            'Create search criteria
            Search.Filter = "(objectClass=User)"
            Search.SearchScope = SearchScope.OneLevel
            Search.PageSize = 200000
            Search.PropertiesToLoad.Add("description")
            Search.PropertiesToLoad.Add("cn")
            Search.PropertiesToLoad.Add("wbemPath")

            'Search the directory and return paths of matching users
            Dim Results As SearchResultCollection = Search.FindAll()
            Dim Description As String = Constants.DEFAULTSTRINGVALUE
            Dim cn As String

            Dim ObjectCount As Integer = 1

            For Each Result As SearchResult In Results
                Try
                    Description = Result.Properties("description")(0).ToString
                Catch
                    Try
                        Result.Properties("description").Item(0).ToString()
                    Catch ex As Exception
                        Description = Constants.DEFAULTSTRINGVALUE
                    End Try
                End Try
                FileLoggingObject.WriteEvent("Lookup has retrieved a description of " & Description, LOGGING_LEVEL.DEBUGGING)

                cn = Result.Properties("cn")(0).ToString
                FileLoggingObject.WriteEvent("Lookup has retrieved a cn of " & cn, LOGGING_LEVEL.DEBUGGING)
                If ReturnDescriptionOnly Then
                    SiteCollection.Add(cn, Description)
                Else
                    Dim wbemPath As String = ""
                    For Each Value As String In Result.Properties("wbemPath")
                        wbemPath &= Value & "|"
                    Next
                    FileLoggingObject.WriteEvent("Lookup has retrieved a wbemPath of " & wbemPath, LOGGING_LEVEL.DEBUGGING)
                    If wbemPath.EndsWith("|") Then wbemPath = wbemPath.Substring(0, wbemPath.Length - 1)
                    SiteCollection.Add(cn, Description & "|" & wbemPath)
                End If
                ObjectCount += 1
            Next

            FileLoggingObject.WriteEvent("ObjectCount = " & ObjectCount - 1, LOGGING_LEVEL.DEBUGGING)

            de.Close()
            de = Nothing
        Catch ex As Exception
            FileLoggingObject.WriteEvent("Error binding to the lookup list!", LOGGING_LEVEL.ERRORS)
            FileLoggingObject.WriteEvent("Error message: " & ex.Message, LOGGING_LEVEL.ERRORS)
        End Try

        Return SiteCollection

    End Function

    Public Function GetLookupValue(ByVal Key As String, ByVal ListName As String) As String
        Dim ReturnValue As String = ""
        Dim ValueCollection As Collections.Specialized.OrderedDictionary = GetLookupCollection(CurrentDirectoryServer, ListName, True, TargetDirectoryConfigurationRootDN, TargetDirectoryConnectionUsername, TargetDirectoryConnectionPassword)

        ReturnValue = CollectionValue(Key, ValueCollection)

        Return ReturnValue
    End Function

    Public Function RemoveServerFromDN(ByVal DNPath As String) As String
        Dim ResultString As String = DNPath

        If DNPath.ToUpper.StartsWith("LDAP://") Then
            ResultString = DNPath.Substring(7)
            ResultString = ResultString.Substring(ResultString.IndexOf("/") + 1)
        End If

        Return ResultString
    End Function

    Public Function DirectorySafeCharacters(ByVal InputString As String) As String
        Dim OutputString As String = InputString

        OutputString = OutputString.Replace("\", ".")
        OutputString = OutputString.Replace(",", ".")
        OutputString = OutputString.Replace("'", ".")
        OutputString = OutputString.Replace("+", ".")
        OutputString = OutputString.Replace(Chr(34), ".")
        OutputString = OutputString.Replace("/", ".")
        OutputString = OutputString.Replace("<", ".")
        OutputString = OutputString.Replace(">", ".")
        OutputString = OutputString.Replace("(", ".")
        OutputString = OutputString.Replace(")", ".")
        OutputString = OutputString.Replace("=", ".")
        OutputString = OutputString.Replace(";", ".")
        OutputString = OutputString.Replace("#", ".")
        OutputString = OutputString.Replace("*", ".")

        Return OutputString
    End Function

#End Region

#Region " Config File "

    Public Sub LoadConfigSection(ByVal SectionName As String, Optional ByVal NameFilter As String = "*")
        Dim FileOpenResult As ERRORTYPE
        Dim ConfigNode As XPathNavigator = Nothing
        Dim SettingComplete As Boolean = False
        Dim MoveResult As Boolean = False

        OpenExternalConfigurationFile(ConfigNode)

        FileOpenResult = LastStatus.CADS_ERRORCODE

        If FileOpenResult = SUCCESS Then

            ' First clear the existing contents
            ConfigContents.Clear()

            If ConfigNode.HasChildren Then
                ConfigNode.MoveToFirstChild()
                Do
                    If ConfigNode.Name Like SectionName Then
                        MoveResult = ConfigNode.MoveToFirstChild()
                        If MoveResult Then
                            Do
                                If ConfigNode.Name Like (NameFilter) Then
                                    ConfigContents.Add(ConfigNode.Name, ConfigNode.Value)
                                End If
                            Loop Until ConfigNode.MoveToNext = False
                            SettingComplete = True
                        Else
                            ' No children
                            SettingComplete = True
                        End If
                    End If
                Loop Until (ConfigNode.MoveToNext = False Or SettingComplete = True)
            End If
        Else
            ' LastStatus now contains the necessary information for us to determine the cause of the problem.
        End If

    End Sub

    ''' <summary>
    ''' Adds the given section
    ''' </summary>
    ''' <param name="SectionName">The section to add</param>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Sub AddConfigSection(ByVal SectionName As String)
        Dim SettingComplete As Boolean = False

        Try
            Dim ConfigNode As XPathNavigator = Nothing
            Dim FileOpenResult As Int32

            OpenExternalConfigurationFile(ConfigNode)

            FileOpenResult = LastStatus.CADS_ERRORCODE

            If FileOpenResult = SUCCESS Then
                ConfigNode.AppendChildElement("", SectionName, "", "")
                m_ConfigDocument.Save(m_ConfigFilenameAndPath)
                SettingComplete = True

                ConfigNode = Nothing
                LastStatus.Clear()
                LastStatus.CADS_ERRORCODE = SUCCESS
            Else
                LastStatus.Clear()
                LastStatus.CADS_ERRORCODE = FileOpenResult
            End If

        Catch ex As Exception
            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, ERROR_CONFIGURATION.SETTING_CREATE_ERROR)
            LastStatus.LastException = ex
        End Try

    End Sub

    ''' <summary>
    ''' Adds the given setting
    ''' </summary>
    ''' <param name="SectionName">The setting to add</param>
    ''' <param name="SettingName">The setting to add</param>
    ''' <param name="SettingValue">The default value to write</param>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Sub AddConfigSetting(ByVal SectionName As String, ByVal SettingName As String, ByVal SettingValue As String)
        Dim SettingComplete As Boolean = False

        Try
            Dim ConfigNode As XPathNavigator = Nothing
            Dim FileOpenResult As Int32

            OpenExternalConfigurationFile(ConfigNode)

            FileOpenResult = LastStatus.CADS_ERRORCODE

            If FileOpenResult = SUCCESS Then
                ConfigNode.MoveToFirstChild()
                Do
                    If ConfigNode.Name Like SectionName Then
                        'ConfigNode.MoveToFirstChild()
                        ConfigNode.AppendChildElement("", SettingName, Nothing, SettingValue)
                        m_ConfigDocument.Save(m_ConfigFilenameAndPath)
                        SettingComplete = True
                    End If
                Loop Until (ConfigNode.MoveToNext = False Or SettingComplete = True)


                ConfigNode = Nothing
                LastStatus.Clear()
                LastStatus.CADS_ERRORCODE = SUCCESS
            Else
                LastStatus.Clear()
                LastStatus.CADS_ERRORCODE = FileOpenResult
            End If

        Catch ex As Exception
            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, ERROR_CONFIGURATION.SETTING_CREATE_ERROR)
            LastStatus.LastException = ex
        End Try

    End Sub

    ''' <summary>
    ''' Adds the given attribute to a setting
    ''' </summary>
    ''' <param name="SectionName">The section to add to</param>
    ''' <param name="SettingName">The setting to add</param>
    ''' <param name="AttributeName"></param>
    ''' <param name="AttributeValue"></param>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Sub AddConfigSettingAttribute(ByVal SectionName As String, ByVal SettingName As String, ByVal AttributeName As String, ByVal AttributeValue As String)
        Dim SettingComplete As Boolean = False

        Try
            Dim ConfigNode As XPathNavigator = Nothing
            Dim FileOpenResult As Int32
            Dim ResultOfMove As Boolean

            OpenExternalConfigurationFile(ConfigNode)

            FileOpenResult = LastStatus.CADS_ERRORCODE

            If FileOpenResult = SUCCESS Then
                ResultOfMove = ConfigNode.MoveToChild(SectionName, "")
                If ResultOfMove = True Then
                    ResultOfMove = ConfigNode.MoveToChild(SettingName, "")
                    If ResultOfMove = True Then
                        ConfigNode.CreateAttribute("", AttributeName, Nothing, AttributeValue)
                        m_ConfigDocument.Save(m_ConfigFilenameAndPath)
                        SettingComplete = True
                    Else
                        ' Setting not found
                        LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, SETTING_NOT_FOUND)
                    End If
                Else
                    ' Section not found
                    LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, SECTION_NOT_FOUND)
                End If

                ConfigNode = Nothing
                LastStatus.Clear()
                LastStatus.CADS_ERRORCODE = SUCCESS
            Else
                LastStatus.Clear()
                LastStatus.CADS_ERRORCODE = FileOpenResult
            End If

        Catch ex As Exception
            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, ERROR_CONFIGURATION.ATTRIBUTE_WRITE_ERROR)
            LastStatus.LastException = ex
        End Try

    End Sub

    ''' <summary>
    ''' Adds the given setting and attribute
    ''' </summary>
    ''' <param name="SectionName">The section to add to</param>
    ''' <param name="SettingName">The setting to add</param>
    ''' <param name="SettingValue">The default value to write</param>
    ''' <param name="AttributeName"></param>
    ''' <param name="AttributeValue"></param>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Sub AddConfigSettingAndAttribute(ByVal SectionName As String, ByVal SettingName As String, ByVal SettingValue As String, ByVal AttributeName As String, ByVal AttributeValue As String)
        Dim SettingComplete As Boolean = False

        Try
            Dim ConfigNode As XPathNavigator = Nothing
            Dim FileOpenResult As Int32

            OpenExternalConfigurationFile(ConfigNode)

            FileOpenResult = LastStatus.CADS_ERRORCODE

            If FileOpenResult = SUCCESS Then
                ConfigNode.MoveToFirstChild()
                Do
                    If ConfigNode.Name Like SectionName Then
                        'ConfigNode.MoveToFirstChild()
                        ConfigNode.AppendChildElement("", SettingName, Nothing, SettingValue)
                        ConfigNode.MoveToChild(SettingName, "")
                        ConfigNode.CreateAttribute("", AttributeName, Nothing, AttributeValue)
                        m_ConfigDocument.Save(m_ConfigFilenameAndPath)
                        SettingComplete = True
                    End If
                Loop Until (ConfigNode.MoveToNext = False Or SettingComplete = True)

                ConfigNode = Nothing
                LastStatus.Clear()
                LastStatus.CADS_ERRORCODE = SUCCESS
            Else
                LastStatus.Clear()
                LastStatus.CADS_ERRORCODE = FileOpenResult
            End If

        Catch ex As Exception
            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, ERROR_CONFIGURATION.SETTING_CREATE_ERROR)
            LastStatus.LastException = ex
        End Try

    End Sub

    ''' <summary>
    ''' Reads the given String value
    ''' </summary>
    ''' <param name="SettingName">The Setting name</param>
    ''' <param name="DefaultValue">The default value to use</param>
    ''' <returns>The value</returns>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Function LoadConfigSetting(ByVal SectionName As String, ByVal SettingName As String, Optional ByVal DefaultValue As String = DEFAULTSTRINGVALUE) As String
        Dim ReturnValue As String = Constants.DEFAULTSTRINGVALUE

        Try
            Dim ConfigNode As XPathNavigator = Nothing
            Dim FileOpenResult As Int32
            Dim StatusOfLoad As Int32 = 0

            OpenExternalConfigurationFile(ConfigNode)

            FileOpenResult = LastStatus.CADS_ERRORCODE

            If FileOpenResult = SUCCESS Then
                Dim SettingValue As String = Constants.DEFAULTSTRINGVALUE
                SettingValue = LoadConfigValue(ConfigNode, SectionName, SettingName)
                StatusOfLoad = LastStatus.CADS_ERRORCODE

                If StatusOfLoad = SUCCESS Then
                    ConfigNode = Nothing

                    ReturnValue = SettingValue
                    LastStatus.Clear()
                    LastStatus.CADS_ERRORCODE = SUCCESS
                    Return ReturnValue
                Else
                    ReturnValue = Constants.DEFAULTSTRINGVALUE
                    LastStatus.CADS_ERRORCODE = StatusOfLoad
                    Return ReturnValue
                End If

            Else
                LastStatus.CADS_ERRORCODE = FileOpenResult
                Return Constants.DEFAULTSTRINGVALUE ' Error opening External Configuration file
            End If
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, STRING_READ_ERROR)     ' Error Reading Configuration information of type string
            Return Constants.DEFAULTSTRINGVALUE
        End Try

    End Function

    Public Function LoadConfigSettingAttribute(ByVal SectionName As String, ByVal SettingName As String, ByVal AttributeName As String, Optional ByVal DefaultValue As String = DEFAULTSTRINGVALUE) As String
        Dim ReturnValue As String = Constants.DEFAULTSTRINGVALUE

        Try
            Dim ConfigNode As XPathNavigator = Nothing
            Dim FileOpenResult As Int32
            Dim StatusOfLoad As Int32 = 0

            OpenExternalConfigurationFile(ConfigNode)

            FileOpenResult = LastStatus.CADS_ERRORCODE

            If FileOpenResult = SUCCESS Then
                'Dim SettingValue As String = Constants.DEFAULTSTRINGVALUE
                Dim AttributeValue As String = Constants.DEFAULTSTRINGVALUE

                'SettingValue = LoadConfigValue(ConfigNode, SectionName, SettingName)
                AttributeValue = LoadConfigAttribute(ConfigNode, SectionName, SettingName, AttributeName)
                StatusOfLoad = LastStatus.CADS_ERRORCODE

                If StatusOfLoad = SUCCESS Then
                    ConfigNode = Nothing

                    ReturnValue = AttributeValue
                    LastStatus.Clear()
                    LastStatus.CADS_ERRORCODE = SUCCESS
                    Return ReturnValue
                Else
                    ReturnValue = Constants.DEFAULTSTRINGVALUE
                    LastStatus.CADS_ERRORCODE = StatusOfLoad
                    Return ReturnValue
                End If

            Else
                LastStatus.CADS_ERRORCODE = FileOpenResult
                Return Constants.DEFAULTSTRINGVALUE ' Error opening External Configuration file
            End If
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, STRING_READ_ERROR)     ' Error Reading Configuration information of type string
            Return ""
        End Try
    End Function

    Public Sub LoadConfigSettingAttributes(ByVal SectionName As String, ByVal SettingName As String, Optional ByVal DefaultValue As String = DEFAULTSTRINGVALUE, Optional ByVal NameFilter As String = "*")
        Dim FileOpenResult As ERRORTYPE
        Dim ConfigNode As XPathNavigator = Nothing
        Dim SettingComplete As Boolean = False

        OpenExternalConfigurationFile(ConfigNode)

        FileOpenResult = LastStatus.CADS_ERRORCODE

        If FileOpenResult = SUCCESS Then

            ' First clear the existing contents
            ConfigContents.Clear()

            If ConfigNode.HasChildren Then
                ConfigNode.MoveToFirstChild()
                Do
                    If ConfigNode.Name Like SectionName Then
                        ConfigNode.MoveToFirstChild()
                        Do
                            If ConfigNode.Name Like (NameFilter) Then
                                Dim AttributeValue As String = Constants.DEFAULTSTRINGVALUE
                                Dim MoveResult As Boolean = False

                                MoveResult = ConfigNode.MoveToFirstAttribute()
                                Do
                                    AttributeValue = ConfigNode.Value
                                    ConfigContents.Add(ConfigNode.Name, AttributeValue)
                                    MoveResult = ConfigNode.MoveToNextAttribute
                                Loop Until MoveResult = False
                            End If
                        Loop Until ConfigNode.MoveToNext = False
                        SettingComplete = True
                    End If
                Loop Until (ConfigNode.MoveToNext = False Or SettingComplete = True)
            End If
        Else
            ' LastStatus now contains the necessary information for us to determine the cause of the problem.
        End If
    End Sub

    Public Function GetSiteServer(ByVal ADSitename As String, ByVal Level As SERVER_TYPE, ByVal Servers As Collections.Specialized.OrderedDictionary) As String
        Dim PrimaryServer As String = ""
        Dim SecondaryServer As String = ""
        Dim TertiaryServer As String = ""
        Dim Keys As ICollection = Servers.Keys
        Dim Values As ICollection = Servers.Values

        For i As Int16 = 0 To Keys.Count - 1
            If Keys(i).ToString = "PrimaryServer_" & ADSitename Then PrimaryServer = Values(i).ToString
            If Keys(i).ToString = "SecondaryServer_" & ADSitename Then SecondaryServer = Values(i).ToString
            If Keys(i).ToString = "TertiaryServer_" & ADSitename Then TertiaryServer = Values(i).ToString
        Next

        Select Case Level
            Case SERVER_TYPE.Primary
                Return PrimaryServer
            Case SERVER_TYPE.Secondary
                Return SecondaryServer
            Case SERVER_TYPE.Tertiary
                Return TertiaryServer
            Case Else
                Return Constants.DEFAULTSTRINGVALUE
        End Select

    End Function

    Public Function CollectionValue(ByVal SettingName As String, ByVal SettingsCollection As OrderedDictionary) As String
        Dim Keys As ICollection = SettingsCollection.Keys
        Dim Values As ICollection = SettingsCollection.Values

        '#If DEBUG Then
        '        Debug.Print("Retrieving Value of " & SettingName & " from Collection")
        '#End If

        For i As Int16 = 0 To Keys.Count - 1
            '#If DEBUG Then
            '            Debug.Print("..." & Keys(i).ToString & " = " & Values(i).ToString)
            '#End If
            If Keys(i).ToString = SettingName Then Return Values(i).ToString
        Next

        Return Constants.DEFAULTSTRINGVALUE
    End Function

    '''' <summary>
    '''' Writes the given String value
    '''' </summary>
    '''' <param name="SettingName">The Setting name</param>
    '''' <remarks>V1.0  D. Robinson</remarks>
    Public Sub SaveConfigSetting(ByVal SectionName As String, ByVal SettingName As String, ByVal Value As String)
        Try
            Dim ConfigNode As XPathNavigator = Nothing
            Dim FileOpenResult As Int32
            Dim StatusOfSave As Int32 = 0

            OpenExternalConfigurationFile(ConfigNode)
            FileOpenResult = LastStatus.CADS_ERRORCODE

            If FileOpenResult = SUCCESS Then
                SaveConfigValue(ConfigNode, SectionName, SettingName, Value)
                StatusOfSave = LastStatus.CADS_ERRORCODE

                If StatusOfSave = SUCCESS Then
                    ConfigNode = Nothing
                    LastStatus.CADS_ERRORCODE = SUCCESS
                Else
                    LastStatus.CADS_ERRORCODE = StatusOfSave
                End If
            Else
                LastStatus.CADS_ERRORCODE = FileOpenResult ' Error opening External Configuration file
            End If
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, STRING_WRITE_ERROR)     ' Error Writing Configuration information of type string
        End Try

    End Sub

    ''' <summary>
    ''' Writes the given String value
    ''' </summary>
    ''' <param name="SettingName">The Setting name</param>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Sub SaveConfigSettingAttribute(ByVal SectionName As String, ByVal SettingName As String, ByVal AttributeName As String, ByVal AttributeValue As String)
        Try
            Dim ConfigNode As XPathNavigator = Nothing
            Dim FileOpenResult As Int32
            Dim StatusOfSave As Int32 = 0

            OpenExternalConfigurationFile(ConfigNode)
            FileOpenResult = LastStatus.CADS_ERRORCODE

            If FileOpenResult = SUCCESS Then
                SaveConfigAttribute(ConfigNode, SectionName, SettingName, AttributeName, AttributeValue)
                StatusOfSave = LastStatus.CADS_ERRORCODE

                If StatusOfSave = SUCCESS Then
                    ConfigNode = Nothing
                    LastStatus.CADS_ERRORCODE = SUCCESS
                Else
                    LastStatus.CADS_ERRORCODE = StatusOfSave
                End If
            Else
                LastStatus.CADS_ERRORCODE = FileOpenResult ' Error opening External Configuration file
            End If
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, STRING_WRITE_ERROR)     ' Error Writing Configuration information of type string
        End Try

    End Sub

    ''' <summary>
    ''' Deletes the given setting
    ''' </summary>
    ''' <param name="SettingName">The Setting name</param>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Sub DeleteConfigSetting(ByVal SectionName As String, ByVal SettingName As String)
        Try
            Dim ConfigNode As XPathNavigator = Nothing
            Dim FileOpenResult As Int32
            Dim ResultOfMove As Boolean

            OpenExternalConfigurationFile(ConfigNode)

            FileOpenResult = LastStatus.CADS_ERRORCODE

            If FileOpenResult = SUCCESS Then
                ResultOfMove = ConfigNode.MoveToChild(SectionName, "")
                If ResultOfMove = True Then
                    ResultOfMove = ConfigNode.MoveToChild(SettingName, "")
                    If ResultOfMove = True Then
                        ConfigNode.DeleteSelf()
                        m_ConfigDocument.Save(m_ConfigFilenameAndPath)
                        LastStatus.CADS_ERRORCODE = SUCCESS
                    Else
                        ' Setting not found
                    End If
                Else
                    ' Section not found
                    LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, SETTING_DELETE_ERROR)
                End If
            Else
                LastStatus.CADS_ERRORCODE = FileOpenResult ' Error opening External Configuration file
            End If
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, SETTING_DELETE_ERROR)     ' Error Reading Configuration information of type string
        End Try

    End Sub

    ''' <summary>
    ''' Deletes the given setting
    ''' </summary>
    ''' <param name="SettingName">The Setting name</param>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Sub DeleteConfigSettingAttribute(ByVal SectionName As String, ByVal SettingName As String, ByVal AttributeName As String)
        Try
            Dim ConfigNode As XPathNavigator = Nothing
            Dim FileOpenResult As Int32
            Dim ResultOfMove As Boolean

            OpenExternalConfigurationFile(ConfigNode)

            FileOpenResult = LastStatus.CADS_ERRORCODE

            If FileOpenResult = SUCCESS Then
                ResultOfMove = ConfigNode.MoveToChild(SectionName, "")
                If ResultOfMove = True Then
                    ResultOfMove = ConfigNode.MoveToChild(SettingName, "")
                    If ResultOfMove = True Then
                        ResultOfMove = ConfigNode.MoveToAttribute(AttributeName, "")
                        If ResultOfMove = True Then
                            ConfigNode.DeleteSelf()
                            m_ConfigDocument.Save(m_ConfigFilenameAndPath)
                            LastStatus.CADS_ERRORCODE = SUCCESS
                        Else
                            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, ATTRIBUTE_DELETE_ERROR)
                        End If
                    Else
                        ' Setting not found
                        LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, SETTING_NOT_FOUND)
                    End If
                Else
                    ' Section not found
                    LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, ATTRIBUTE_DELETE_ERROR)
                End If
            Else
                LastStatus.CADS_ERRORCODE = FileOpenResult ' Error opening External Configuration file
            End If
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, SETTING_DELETE_ERROR)     ' Error Reading Configuration information of type string
        End Try

    End Sub

    ''' <summary>
    ''' Opens the External Configuration file
    ''' </summary>
    ''' <param name="Navigator">XPathNavigator</param>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Private Sub OpenExternalConfigurationFile(ByRef Navigator As XPathNavigator)
        If m_ConfigFilenameAndPath.Length = 0 Then
            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, SETTING_READ_ERROR)
        End If
        If IO.File.Exists(m_ConfigFilenameAndPath) Then
            Try
                m_ConfigDocument.Load(m_ConfigFilenameAndPath)

                Dim Nav As XPathNavigator = m_ConfigDocument.CreateNavigator()
                Dim ConfigNode As XPathNavigator = Nav.SelectSingleNode("/configuration")

                Navigator = ConfigNode.Clone

                ConfigNode = Nothing
                Nav = Nothing

                LastStatus.CADS_ERRORCODE = SUCCESS
            Catch ex As DirectoryNotFoundException
                LastStatus.LastException = ex
                LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.FILESYSTEM, DIRECTORY_NOT_FOUND) ' Directory not found Error opening External Configuration file
            Catch ex As FileNotFoundException
                LastStatus.LastException = ex
                LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.FILESYSTEM, FILE_NOT_FOUND) ' File not found Error opening External Configuration file
            End Try
        Else
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.FILESYSTEM, FILE_NOT_FOUND) ' File not found Error opening External Configuration file
        End If
    End Sub

    ''' <summary>
    ''' Reads the value from the configuration file
    ''' </summary>
    ''' <param name="Node">XPathNavigator</param>
    ''' <param name="SectionName">The Section name</param>
    ''' <param name="SettingName">The Setting name</param>
    ''' <returns>The Value</returns>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Private Function LoadConfigValue(ByVal Node As XPathNavigator, ByVal SectionName As String, ByVal SettingName As String) As String
        Dim ResultOfMove As Boolean = False
        Dim Result As String = ""
        Dim ReadComplete As Boolean = False

        If Node.HasChildren Then
            Node.MoveToFirstChild()
            Do
                If Node.Name Like SectionName Then
                    'Node.MoveToFirstChild()
                    Do
                        Node.SelectSingleNode(SettingName)
                        ResultOfMove = Node.MoveToChild(SettingName, "")
                        If ResultOfMove = True Then
                            Result = Node.Value
                            LastStatus.CADS_ERRORCODE = SUCCESS
                            ReadComplete = True
                        Else  ' Unsuccessful
                            Result = Constants.DEFAULTSTRINGVALUE
                            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, SETTING_NOT_FOUND) ' Error Reading Configuration.  Setting not found
                        End If
                    Loop Until Node.MoveToNext = False Or ReadComplete = True
                End If
            Loop Until (Node.MoveToNext = False Or ReadComplete = True)
        End If
        Return Result
    End Function

    ''' <summary>
    ''' Reads the attribute from the configuration file
    ''' </summary>
    ''' <param name="Node">XPathNavigator</param>
    ''' <param name="SectionName">The Section name</param>
    ''' <param name="SettingName">The Setting name</param>
    ''' <param name="AttributeName">The attribute</param>
    ''' <returns>The Attribute</returns>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Private Function LoadConfigAttribute(ByVal Node As XPathNavigator, ByVal SectionName As String, ByVal SettingName As String, ByVal AttributeName As String) As String
        Dim ResultOfMove As Boolean = False
        Dim Result As String = ""
        Dim ReadComplete As Boolean = False

        If Node.HasChildren Then
            Node.MoveToFirstChild()
            Do
                If Node.Name Like SectionName Then
                    'Node.MoveToFirstChild()
                    Do
                        Node.SelectSingleNode(SettingName)
                        ResultOfMove = Node.MoveToChild(SettingName, "")
                        If ResultOfMove = True Then
                            Result = Node.GetAttribute(AttributeName, "")
                            'Result = Node.Value
                            LastStatus.CADS_ERRORCODE = SUCCESS
                            ReadComplete = True
                        Else  ' Unsuccessful
                            Result = Constants.DEFAULTSTRINGVALUE
                            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, SETTING_NOT_FOUND) ' Error Reading Configuration.  Setting not found
                        End If
                    Loop Until Node.MoveToNext = False Or ReadComplete = True
                End If
            Loop Until (Node.MoveToNext = False Or ReadComplete = True)
        End If
        Return Result
    End Function

    ''' <summary>
    ''' Writes the value to the configuration file
    ''' </summary>
    ''' <param name="Node">XPathNavigator</param>
    ''' <param name="SectionName">The Section name</param>
    ''' <param name="SettingName">The Setting name</param>
    ''' <param name="SettingValue">The value</param>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Private Sub SaveConfigValue(ByVal Node As XPathNavigator, ByVal SectionName As String, ByVal SettingName As String, ByVal SettingValue As String)
        Dim ResultOfMove As Boolean = False
        Dim ReadComplete As Boolean = False

        If Node.HasChildren Then
            Node.MoveToFirstChild()
            Do
                If Node.Name Like SectionName Then
                    'Node.MoveToFirstChild()
                    Do

                        Node.SelectSingleNode(SettingName)
                        ResultOfMove = Node.MoveToChild(SettingName, "")
                        If ResultOfMove = True Then
                            ' Save the value to this node
                            Try
                                Node.SetValue(SettingValue)
                                m_ConfigDocument.Save(m_ConfigFilenameAndPath)
                                LastStatus.CADS_ERRORCODE = SUCCESS
                            Catch ex As Exception
                                LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, WRITE_NOT_SUPPORTED) ' Error Writing Configuration.  Writes not supported
                            End Try
                            ReadComplete = True
                        Else  ' Unsuccessful
                            Try
                                Node.AppendChild(SettingName)
                                Try
                                    ResultOfMove = Node.MoveToChild(SettingName, "")
                                    Node.SetValue(SettingValue)
                                Catch ex As Exception
                                    LastStatus.LastException = ex
                                    LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, WRITE_NOT_PERFORMED) ' Error Writing Configuration.  Could not save new value
                                End Try
                            Catch ex As Exception
                                LastStatus.LastException = ex
                                LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, WRITE_ERROR) ' Error Writing Configuration.  Could not append setting
                            End Try
                            ReadComplete = True
                        End If
                    Loop Until Node.MoveToNext = False Or ReadComplete = True
                End If
            Loop Until (Node.MoveToNext = False Or ReadComplete = True)
        End If
    End Sub

    ''' <summary>
    ''' Writes the attribute to the configuration file
    ''' </summary>
    ''' <param name="Node">XPathNavigator</param>
    ''' <param name="SectionName">The Section name</param>
    ''' <param name="SettingName">The Setting name</param>
    ''' <param name="AttributeName">The attribute</param>
    ''' <param name="AttributeValue">The attribute value</param>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Private Sub SaveConfigAttribute(ByVal Node As XPathNavigator, ByVal SectionName As String, ByVal SettingName As String, ByVal AttributeName As String, ByVal AttributeValue As String)
        Dim ResultOfMove As Boolean = False
        Dim ReadComplete As Boolean = False

        If Node.HasChildren Then
            Node.MoveToFirstChild()
            Do
                If Node.Name Like SectionName Then
                    'Node.MoveToFirstChild()
                    Do
                        Node.SelectSingleNode(SettingName)
                        ResultOfMove = Node.MoveToChild(SettingName, "")
                        If ResultOfMove = True Then
                            ' Save the value to this attribute
                            Try
                                Node.MoveToAttribute(AttributeName, "")

                                Node.SetValue(AttributeValue)
                                m_ConfigDocument.Save(m_ConfigFilenameAndPath)
                                LastStatus.CADS_ERRORCODE = SUCCESS
                            Catch ex As Exception
                                LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, WRITE_NOT_SUPPORTED) ' Error Writing Configuration.  Writes not supported
                            End Try
                            ReadComplete = True
                        Else  ' Unsuccessful
                            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CONFIGURATION, WRITE_NOT_PERFORMED) ' Error Writing Configuration.  Could not save new value
                        End If
                    Loop Until Node.MoveToNext = False Or ReadComplete = True
                End If
            Loop Until (Node.MoveToNext = False Or ReadComplete = True)
        End If
    End Sub

    Public Function MySettings(ByVal Username As String) As System.Collections.Specialized.OrderedDictionary
        Dim FinalSettings As New OrderedDictionary
        Dim SystemSettings As New OrderedDictionary
        Dim DirectorySettings As New OrderedDictionary
        Dim SystemSecurityLevels As New OrderedDictionary
        Dim ConsoleUserSettings As New OrderedDictionary
        Dim Servers As New OrderedDictionary
        Dim SecurityLevels As New OrderedDictionary
        Dim MySecuritylevel As UInt64

        Dim UserSettings As New OrderedDictionary
        Dim LevelSettings As New OrderedDictionary
        Dim ConsoleSearchFields As New OrderedDictionary
        Dim DirectoryServer As New OrderedDictionary
        Dim ConsoleDetailFields As New OrderedDictionary
        Dim ConfigFilename As String = m_ConfigFilenameAndPath ' Save this because we have to switch between files
        Dim NonStandardConfigFilename As String = ""
        Dim UserConfigExists As Boolean = False
        Dim UsernameToCheck As String = Replace(Username, "\", "_")

        ' ------------------------------------------------------------------------------------------
        ' Load all System settings
        LoadConfigSection("SystemSettings") ' Should only contain TemporaryAccounts and EncryptionKey
        CloneCollection(ConfigContents, SystemSettings)
        ' ------------------------------------------------------------------------------------------
        ' Load system Security Levels
        LoadConfigSection("SystemSecurityLevels") ' Contains Security levels
        CloneCollection(ConfigContents, SystemSecurityLevels)
        ' ------------------------------------------------------------------------------------------
        ' Load User Console settings
        LoadConfigSection("ConsoleUserSettings") ' Contains System settings that are customisable, and are not in CADS.config
        CloneCollection(ConfigContents, ConsoleUserSettings)
        ' ------------------------------------------------------------------------------------------
        ' Load the default Directory servers
        LoadConfigSection("DirectoryServer") ' Contains basic config settings
        CloneCollection(ConfigContents, DirectoryServer)
        FileLoggingObject.WriteEvent("Default Server from config file is " & CollectionValue("Default", DirectoryServer), LOGGING_LEVEL.DEBUGGING)
        ' ------------------------------------------------------------------------------------------
        ' Determine what level names this user has
        MySecuritylevel = GetUserAccessLevel(Username)

        ' Switch to the User-specific config
        NonStandardConfigFilename = m_AppDataPath & "\Users\" & UsernameToCheck & ".config"

        FileLoggingObject.WriteEvent("MySettings: Reading data from Config File " & NonStandardConfigFilename, LOGGING_LEVEL.DEBUGGING)

        If IO.File.Exists(NonStandardConfigFilename) Then
            ConfigFilenameAndPath = NonStandardConfigFilename
            ' Load User settings
            LoadConfigSection("ConsoleUserSettings")
            CloneCollection(ConfigContents, UserSettings)
            ' If the user config exists, it will over-ride the level config
            DirectorySettings.Clear()
            ConsoleSearchFields.Clear()
            ConsoleDetailFields.Clear()
            LoadConfigSection("DirectorySettings")
            CloneCollection(ConfigContents, DirectorySettings)

            FileLoggingObject.WriteEvent("MySettings: determining Location", LOGGING_LEVEL.DEBUGGING)
            ' Get Location to determine servers
            UserDefaultLocation = CollectionValue("Location", DirectorySettings)
            FileLoggingObject.WriteEvent("MySettings: UserDefaultLocation=" & UserDefaultLocation, LOGGING_LEVEL.DEBUGGING)
            ' Now retrieve the list of servers for this location from ADAM
            Dim ConfigurationServerName As String = ""
            Try
                Dim EncryptedEncryptionKey As String = CollectionValue("EncryptionKey", SystemSettings)
                Dim DecryptedEncryptionKey As String = SimpleCrypt(EncryptedEncryptionKey)
                Dim DirectoryUsername As String = CollectionValue("DirectoryUserUsername", DirectorySettings)
                Dim EncryptedDirectoryPassword As String = CollectionValue("DirectoryUserPassword", DirectorySettings)
                Dim DecryptedDirectoryPassword As String = XMLDecrypt(EncryptedDirectoryPassword, DecryptedEncryptionKey)
                ConfigurationServerName = CollectionValue("Default", DirectoryServer)
                Dim DirectoryConfigurationPath As String = CollectionValue("ConfigurationRoot", DirectoryServer)

                FileLoggingObject.WriteEvent("*****************************", LOGGING_LEVEL.DEBUGGING)
                FileLoggingObject.WriteEvent("DEBUGGING INFORMATION FOLLOWS", LOGGING_LEVEL.DEBUGGING)
                FileLoggingObject.WriteEvent("DirectoryConfigurationPath :" & DirectoryConfigurationPath, LOGGING_LEVEL.DEBUGGING)
                FileLoggingObject.WriteEvent("DirectoryUsername          :"REDACTED"DecryptedDirectoryPassword :"REDACTED"*****************************", LOGGING_LEVEL.DEBUGGING)

                Servers = GetLookupCollection(ConfigurationServerName, "Locations", False, DirectoryConfigurationPath, DirectoryUsername, DecryptedDirectoryPassword)

                ' Finally, get the actual server names
                Dim TempDirectoryServers() As String
                TempDirectoryServers = Split(CollectionValue(UserDefaultLocation, Servers), "|")
                For i As Integer = 1 To TempDirectoryServers.Count - 1
                    ReDim Preserve DirectoryServers(i - 1)
                    DirectoryServers(i - 1) = TempDirectoryServers(i)
                Next

                If DirectoryServers.Length = 0 Then
                    ReDim DirectoryServers(0)
                    DirectoryServers(0) = ConfigurationServerName
                    FileLoggingObject.WriteWarningEvent("Server could not be determined.  Using Configuration Server. (1)")
                End If
            Catch
                Try
                    DirectoryServers(0) = ConfigurationServerName
                    FileLoggingObject.WriteWarningEvent("Server could not be determined.  Using Configuration Server. (2)")
                Catch ex As Exception

                End Try
            End Try
            LoadConfigSection("ConsoleSearchFields")
            CloneCollection(ConfigContents, ConsoleSearchFields)
            LoadConfigSection("ConsoleDetailFields")
            CloneCollection(ConfigContents, ConsoleDetailFields)

            UserConfigExists = True
        End If

        ' Combine all of these settings into one collection
        ' SystemSettings
        CloneCollection(SystemSettings, FinalSettings)
        ' SystemSecurityLevels
        CloneCollection(SystemSecurityLevels, FinalSettings)
        ' DirectoryServers
        CloneCollection(Servers, FinalSettings)
        ' DirectorySettings
        CloneCollection(DirectorySettings, FinalSettings)
        ' ConsoleSearchFields
        CloneCollection(ConsoleSearchFields, FinalSettings)
        ' ConsoleDetailFields 
        CloneCollection(ConsoleDetailFields, FinalSettings)
        ' DirectoryServer
        CloneCollection(DirectoryServer, FinalSettings)
        'If UserConfigExists Then ' 
        MergeCollections(UserSettings, LevelSettings, FinalSettings)
        'End If

        ' Finally, switch back to the standard config
        m_ConfigFilenameAndPath = ConfigFilename

        Return FinalSettings
    End Function

    Public Function MySection(ByVal Username As String, ByVal SectionName As String) As System.Collections.Specialized.OrderedDictionary
        Dim FinalSettings As New OrderedDictionary
        Dim SecurityLevels As New OrderedDictionary
        Dim MySecuritylevel As UInt64

        Dim UserSettings As New OrderedDictionary
        Dim LevelSettings As New OrderedDictionary
        Dim ConfigFilename As String = m_ConfigFilenameAndPath ' Save this because we have to switch between files
        Dim NonStandardConfigFilename As String = ""
        Dim UserConfigExists As Boolean = False
        Dim UsernameToCheck As String = Replace(Username, "\", "_")

        ' Determine what level names this user has
        MySecuritylevel = GetUserAccessLevel(Username)

        ' Switch to the User-specific config
        NonStandardConfigFilename = m_AppDataPath & "\Users\" & UsernameToCheck & ".config"

        If IO.File.Exists(NonStandardConfigFilename) Then
            m_ConfigFilenameAndPath = NonStandardConfigFilename
            ' Load User settings
            LoadConfigSection(SectionName)
            CloneCollection(ConfigContents, UserSettings)
            UserConfigExists = True
        End If

        ' Now we have the following 2 collections that we have to choose each setting individually:
        ' LevelSettings
        ' UserSettings
        ' This is because we can over-ride these settings individually

        ' Combine these settings into one collection
        If UserConfigExists Then ' 
            MergeCollections(UserSettings, LevelSettings, FinalSettings)
        End If

        ' Finally, switch back to the standard config
        m_ConfigFilenameAndPath = ConfigFilename

        Return FinalSettings
    End Function


    Public Sub StartClient()
        If m_ClientState = SERVICE_STATE.STARTED Then
            Debug.Print("Client is already running.")
        Else
            Try
                m_ClientChannel = New ChannelFactory(Of IService)(New WebHttpBinding(), "http://" & m_ServerAddress)

                m_ClientChannel.Endpoint.Behaviors.Add(New WebHttpBehavior())

                ConfigClient = m_ClientChannel.CreateChannel()

                Debug.Print("Client is running...")
                m_ClientState = SERVICE_STATE.STARTED

            Catch cex As CommunicationException
            Catch ex As Exception
            End Try
        End If
    End Sub

    Public Sub StopClient()
        If m_ClientState = SERVICE_STATE.STOPPED Then
            Debug.Print("Client is already stopped.")
        Else
            Try
                m_ClientChannel.Close()
            Catch ex As Exception
            End Try
            Debug.Print("Client is stopped.")
        End If
    End Sub

    Private Sub UpdateServerAddress()
        If m_Port <> 0 Then
            m_ServerAddress = m_Host & ":" & m_Port.ToString
        Else
            m_ServerAddress = m_Host
        End If
    End Sub


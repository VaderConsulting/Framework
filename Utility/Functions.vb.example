    Private Function UserSecurityLevelName(ByVal UserSecurityLevel As Int16) As String
        Dim LevelName As String = DEFAULTSTRINGVALUE
        Dim Index As Int16 = 0
        ' UserSecurityLevel is a number between 1 and 64


        ' TODO:  FIX!!
        'HostInstance.LoadConfigSection("SystemSecurityLevels")

        For Each SecurityLevelValue In ConfigContents.Values ' GetValueList
            Dim SecurityLevel As String = SecurityLevelValue.ToString.Substring(0, SecurityLevelValue.ToString.IndexOf("|"))
            If Convert.ToInt16(SecurityLevel) = UserSecurityLevel Then ' ConfigContents(Index)
                Return ConfigContents.Keys(Index).ToString
            End If
            Index += 1
        Next

        Return LevelName
    End Function

    Public Function DoLogon(Optional ByVal ProvidedPasswordIsEncrypted = False) As String
        Return DoLogon("", "", ProvidedPasswordIsEncrypted)
    End Function

    Public Function DoLogon(ByVal LogonUsername As String, ByVal LogonPassword As String, ByVal ProvidedPasswordIsEncrypted As Boolean) As String
        Dim LoginForm As New Utility.frmLogin
        Dim PerformAutoLogon As Boolean = False
        Dim CADSVersion As String = "4.0"
        Dim LoginResult As System.Windows.Forms.DialogResult
        Dim UserSecurityLevel As String = Constants.DEFAULTSTRINGVALUE
        Dim EncryptedPassword As String = Constants.DEFAULTSTRINGVALUE
        Dim LogonAttemptCount As Integer = 0

        ' If we could not find cads.config during startup, then we cannot continue...
        If m_CADSConfigFileNotFound = True Then Return UserSecurityLevel

        'StartClient()

        Dim EncryptedEncryptionKey As String = LoadConfigSetting("SystemSettings", "EncryptionKey")
        Dim gDecryptedEncryptionKey As String = SimpleCrypt(EncryptedEncryptionKey)

        Do
            If LogonUsername.Length = 0 Then
                LoginForm.AllowWindowsLogon = False

                LoginResult = LoginForm.ShowDialog

                If LoginResult = Windows.Forms.DialogResult.Cancel Then
                    Return Constants.DEFAULTSTRINGVALUE
                End If

                LogonUsername = LoginForm.InteractiveUserUsername.Trim
                LogonPassword =REDACTED

                InteractiveUserUsername = LogonUsername
                InteractiveUserPassword =REDACTED
            Else
                InteractiveUserUsername = LogonUsername
                InteractiveUserPassword =REDACTED
            End If

            Try
                If Not ProvidedPasswordIsEncrypted Then
                    EncryptedPassword =REDACTED gDecryptedEncryptionKey)
                Else
                    EncryptedPassword =REDACTED
                End If

                Dim StoredPassword As String = LoadConfigSettingAttribute("SystemSecurityLevels", InteractiveUserUsername, "Password")

                If StoredPassword =REDACTED Then
                    ' Incorrect Username
                    'Return UserSecurityLevel
                    FileLoggingObject.WriteWarningEvent("Incorrect username")
                    LogonUsername = ""
                    LogonPassword = ""
                    InteractiveUserUsername = LogonUsername
                    InteractiveUserPassword =REDACTED
                    LoginForm.lblIncorrect.Visible = True
                Else
                    If EncryptedPassword =REDACTED Then
                        UserSecurityLevel = GetUserAccessLevel(LogonUsername)

                        If Not DoNotDownloadUserConfiguration Then
                            UpdateUserConfigFile()
                        End If
                    Else
                        ' Incorrect password
                        FileLoggingObject.WriteWarningEvent("Incorrect password")
                        LogonUsername = ""
                        LogonPassword = ""
                        InteractiveUserUsername = LogonUsername
                        InteractiveUserPassword =REDACTED
                        LoginForm.lblIncorrect.Visible = True
                        'LogonAttemptCount += 1
                    End If
                End If
            Catch ex1 As System.ServiceModel.EndpointNotFoundException
                FileLoggingObject.WriteErrorEvent("The Configuration server could not be contacted.  This is a critical error.  " & My.Application.Info.AssemblyName & " cannot continue." & vbCrLf & vbCrLf & "The actual error returned was:" & vbCrLf & ex1.Message)
                Return Constants.DEFAULTSTRINGVALUE
            Catch ex2 As Exception
                FileLoggingObject.WriteErrorEvent("An unexpected error has occured.  This is a critical error.  " & My.Application.Info.AssemblyName & " cannot continue." & vbCrLf & vbCrLf & "The error message returned was:" & vbCrLf & ex2.Message)
                Return Constants.DEFAULTSTRINGVALUE
            End Try
            LogonAttemptCount += 1
        Loop Until (UserSecurityLevel <> Constants.DEFAULTSTRINGVALUE) Or (LogonAttemptCount = 3)

        LoginForm.Close()
        LoginForm = Nothing

        If UserSecurityLevel <> Constants.DEFAULTSTRINGVALUE Then ' Logon is ok
            ' Backdoor...
            If LogonUsername = "REDACTED" Then
                InteractiveUserUsername = "REDACTED"
            End If

            ConfigSettings = MySettings(InteractiveUserUsername)

            InteractiveUserIsAuthenticated = True

            TargetDirectoryConnectionUsername = CollectionValue("DirectoryUserUsername", ConfigSettings)
            TargetDirectoryConnectionPassword =REDACTED"DirectoryUserPassword", ConfigSettings), gDecryptedEncryptionKey)

            FileLoggingObject.WriteEvent("Determining Current Server Name", LOGGING_LEVEL.DEBUGGING)
            CurrentDirectoryServer = DetermineTargetServerName(DirectoryServers)
            FileLoggingObject.WriteEvent("Returned from determining Current Server Name", LOGGING_LEVEL.DEBUGGING)

            If CurrentDirectoryServer <> Constants.DEFAULTSTRINGVALUE Then
                TargetDirectoryUserRootDN = "LDAP://" & CurrentDirectoryServer & CollectionValue("DirectoryUserRoot", ConfigSettings)
                TargetDirectoryPhoneRootDN = "LDAP://" & CurrentDirectoryServer & CollectionValue("DirectoryPhoneRoot", ConfigSettings)
                TargetDirectoryConfigurationRootDN = "LDAP://" & CurrentDirectoryServer & CollectionValue("ConfigurationRoot", ConfigSettings)
            Else
                'MsgBox("No Directory Server could be contacted.  This is a critical error. " & My.Application.Info.AssemblyName & " cannot continue.", MsgBoxStyle.Exclamation + MsgBoxStyle.OkOnly, "Critical error")
                FileLoggingObject.WriteEvent("No Directory Server could be contacted.  This is a critical error.  " & My.Application.Info.AssemblyName & " cannot continue.", LOGGING_LEVEL.DEBUGGING)
            End If

            FileLoggingObject.WriteEvent("*****************************", LOGGING_LEVEL.DEBUGGING)
            FileLoggingObject.WriteEvent("DEBUGGING INFORMATION FOLLOWS", LOGGING_LEVEL.DEBUGGING)
            FileLoggingObject.WriteEvent("*****************************", LOGGING_LEVEL.DEBUGGING)
            FileLoggingObject.WriteEvent("Directory Username      : "REDACTED"Directory Password      : "REDACTED"Directory Path (User)   : " & TargetDirectoryUserRootDN, LOGGING_LEVEL.DEBUGGING)
            FileLoggingObject.WriteEvent("Directory Path (Phone)  : " & TargetDirectoryPhoneRootDN, LOGGING_LEVEL.DEBUGGING)
            FileLoggingObject.WriteEvent("Directory Path (Config) : " & TargetDirectoryConfigurationRootDN, LOGGING_LEVEL.DEBUGGING)
            FileLoggingObject.WriteEvent("*****************************", LOGGING_LEVEL.DEBUGGING)

            Return UserSecurityLevel
        Else
            Return Constants.DEFAULTSTRINGVALUE
        End If

    End Function

    Public Function GetUserAccessLevel(ByVal Username As String) As String
        Dim UsernameToCheck As String = Replace(Username, "\", "_")
        Dim UserAccessLevel As String = Constants.DEFAULTSTRINGVALUE

        If m_UserAccessLevelFound Then
            Return m_UserAccessLevel
            Exit Function
        End If

        ' Check Username is specified
        If Username.Trim.Length = 0 Then
            LastStatus.CADS_ERRORCODE = ErrorResult(Types.ERRORTYPE.SECURITY, Types.ERROR_SECURITY.USERNAME_NOT_SPECIFIED)
            Return Constants.DEFAULTSTRINGVALUE
        End If

        ' Look for the user in our security configuration

        'If LastStatus.CADS_ERRORCODE = SUCCESS Then
        'ConfigFilenameAndPath = m_ConfigFilenameAndPath
        UserAccessLevel = LoadConfigSettingAttribute("SystemSecurityLevels", UsernameToCheck, "SecurityValue")

        If LastStatus.CADS_ERRORCODE = Types.ERRORTYPE.SUCCESS Then
            ' All good
            m_UserAccessLevel = UserAccessLevel
            m_UserAccessLevelFound = True
            Return UserAccessLevel
        Else
            Select Case LastStatus.CADS_ERRORCODE
                Case 131073
                    Debug.Print("HELP!")
                Case Else
            End Select
            LastStatus.CADS_ERRORCODE = ErrorResult(Types.ERRORTYPE.SECURITY, Types.ERROR_SECURITY.NOT_AUTHORISED)
            Return Constants.DEFAULTSTRINGVALUE
        End If

    End Function

#End Region

#Region " Collections "

    Public Function CheckEnforced(ByVal SettingValue As String) As Boolean
        Dim Values() As String
        Dim Value As String
        Dim Enforced As Boolean

        Try
            Values = Split(SettingValue, "|")

            If Values.Length = 2 Then
                Value = Values(0)
                Enforced = CBool(Values(1))
                Return Enforced
            Else
                Return False
            End If
        Catch ex As Exception
            Return False
        End Try
    End Function

    Public Sub CopySetting(ByVal SourceSettingName As String, ByVal DestinationSettingName As String, ByVal SourceCollection As OrderedDictionary, ByRef DestinationCollection As OrderedDictionary)
        Dim CollectionKey As String = SourceSettingName

        If SourceCollection.Contains(SourceSettingName) Then
            If DestinationCollection.Contains(CollectionKey) Then ' replace the existing value
                DestinationCollection.Remove(CollectionKey)
            End If
            DestinationCollection.Add(DestinationSettingName, SourceCollection(CollectionKey))
        End If

    End Sub

    Public Sub CloneCollection(ByVal SourceCollection As OrderedDictionary, ByRef DestinationCollection As OrderedDictionary)
        Dim CollectionItem As DictionaryEntry

        For Each CollectionItem In SourceCollection
            Try
                DestinationCollection.Add(CollectionItem.Key, CollectionItem.Value)
            Catch ex As Exception
            End Try
        Next

    End Sub

    Public Sub MergeCollections(ByVal SourceCollection1 As OrderedDictionary, ByVal SourceCollection2 As OrderedDictionary, ByRef DestinationCollection As OrderedDictionary, Optional ByVal UseEnforcedValue As Boolean = False)
        Dim SourceValueToUse As String

#If DEBUG Then
        Debug.Print("Merging Collections...")
#End If
        For Each CollectionItem In SourceCollection1
            SourceValueToUse = GetOverridingSetting(CollectionItem.Key, SourceCollection1, SourceCollection2)
#If DEBUG Then
            'Debug.Print("..." & SourceValueToUse)
#End If
            DestinationCollection.Add(CollectionItem.Key, SourceValueToUse)
        Next
    End Sub

    Public Function GetOverridingSetting(ByVal SettingName As String, ByVal LevelSettings As OrderedDictionary, ByVal UserSettings As OrderedDictionary) As String
        Dim LevelSetting As String = ""
        Dim UserSetting As String = ""

        Dim LevelSettingEnforced As Boolean = False
        Dim UserSettingEnforced As Boolean = False
        Dim Enforced As Boolean = False

        Dim FinalSetting As String = ""

        If UserSettings.Contains(SettingName) Then
            UserSetting = UserSettings(SettingName)
        End If
        If LevelSettings.Contains(SettingName) Then
            LevelSetting = LevelSettings(SettingName)
        End If

        LevelSettingEnforced = CheckEnforced(LevelSetting)
        UserSettingEnforced = CheckEnforced(UserSetting)

        If UserSettingEnforced Then
            FinalSetting = UserSetting
            Enforced = True
        ElseIf LevelSettingEnforced Then
            FinalSetting = LevelSetting
            Enforced = True
        End If

        If Not Enforced Then
            If UserSetting <> "" Then
                FinalSetting = UserSetting
            ElseIf LevelSetting <> "" Then
                FinalSetting = LevelSetting
            End If
        End If

        Return FinalSetting
    End Function

#End Region

#Region " Encryption "

    ''' <summary>
    ''' Decrypts the given string from a format suitable for output to XML files
    ''' </summary>
    ''' <param name="stringToDecrypt">Input string to decrypt</param>
    ''' <param name="EncryptionKey">The Key used to decrypt the string</param>
    ''' <returns>Decrypted String</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function XMLDecrypt(ByVal stringToDecrypt As String, ByVal EncryptionKey As String) As String
        Dim inputByteArray(stringToDecrypt.Length) As Byte
        Dim RSAkey() As Byte = {}
        Dim IV() As Byte = {&H12, &H34, &H56, &H78, &H90, &HAB, &HCD, &HEF}
        Dim DecryptedString As String
        ' Note: The DES CryptoService only accepts certain key byte lengths
        ' We are going to make things easy by insisting on an 8 byte legal key length

        Try
            RSAkey = System.Text.Encoding.UTF8.GetBytes(Microsoft.VisualBasic.Left(EncryptionKey, 8))
            Dim des As New DESCryptoServiceProvider()
            ' we have a base 64 encoded string so first must decode to regular unencoded (encrypted) string
            inputByteArray = Convert.FromBase64String(stringToDecrypt)
            ' now decrypt the regular string
            Dim ms As New MemoryStream()
            Dim cs As New CryptoStream(ms, des.CreateDecryptor(RSAkey, IV), CryptoStreamMode.Write)
            cs.Write(inputByteArray, 0, inputByteArray.Length)
            cs.FlushFinalBlock()
            Dim encoding As System.Text.Encoding = System.Text.Encoding.UTF8
            DecryptedString = encoding.GetString(ms.ToArray())
            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = SUCCESS
            Return DecryptedString
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CRYPT, DECRYPTION_ERROR)
            Return Constants.DEFAULTSTRINGVALUE
        End Try
    End Function

    ''' <summary>
    ''' Encrypts the given string to a format suitable for XML files
    ''' </summary>
    ''' <param name="stringToEncrypt">Input string to encrypt</param>
    ''' <param name="EncryptionKey">The Key used to decrypt the string</param>
    ''' <returns>The encrypted string</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function XMLEncrypt(ByVal StringToEncrypt As String, ByVal EncryptionKey As String) As String
        Dim RSAkey() As Byte = {}
        Dim IV() As Byte = {&H12, &H34, &H56, &H78, &H90, &HAB, &HCD, &HEF}
        Dim EncryptedString As String

        Try
            RSAkey = System.Text.Encoding.UTF8.GetBytes(Microsoft.VisualBasic.Left(EncryptionKey, 8))
            Dim des As New DESCryptoServiceProvider()
            ' convert our input string to a byte array
            Dim inputByteArray() As Byte = Encoding.UTF8.GetBytes(StringToEncrypt)
            'now encrypt the bytearray
            Dim ms As New MemoryStream()
            Dim cs As New CryptoStream(ms, des.CreateEncryptor(RSAkey, IV), CryptoStreamMode.Write)
            cs.Write(inputByteArray, 0, inputByteArray.Length)
            cs.FlushFinalBlock()
            ' now return the byte array as a "safe for XMLDOM" Base64 String
            EncryptedString = Convert.ToBase64String(ms.ToArray())
            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = SUCCESS
            Return EncryptedString
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CRYPT, ENCRYPTION_ERROR)
            Return Constants.DEFAULTSTRINGVALUE
        End Try
    End Function

    ''' <summary>
    ''' Simple Decryption routine.  Do not use for sensitive information
    ''' </summary>
    ''' <param name="InputText">Input string to en\decrypt</param>
    ''' <returns>Output string en\decrypted</returns>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Function SimpleCrypt(ByVal InputText As String) As String
        Dim OutputText As String

        ' Encrypts/decrypts the passed string using a simple ASCII value-swapping algorithm
        Try
            Dim strTempChar As String = "", i As Integer
            For i = 1 To Len(InputText)
                If Asc(Mid$(InputText, i, 1)) < 128 Then
                    strTempChar = _
              CType(Asc(Mid$(InputText, i, 1)) + 128, String)
                ElseIf Asc(Mid$(InputText, i, 1)) > 128 Then
                    strTempChar = _
              CType(Asc(Mid$(InputText, i, 1)) - 128, String)
                End If
                Mid$(InputText, i, 1) = _
                    Chr(CType(strTempChar, Integer))
            Next i
            OutputText = InputText

            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = SUCCESS

            Return OutputText
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CRYPT, GENERAL_ERROR)
            Return Constants.DEFAULTSTRINGVALUE
            ' ErrorResult(ERRORTYPE.CRYPT, GENERAL_ERROR)
        End Try
    End Function

    ''' <summary>
    ''' 3DES Decryption
    ''' </summary>
    ''' <param name="InputString">String to decrypt</param>
    ''' <param name="CryptoKey">The Key used to decrypt the string</param>
    ''' <returns>The Decrypted string</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function Decrypt3DES(ByVal InputString As String, ByVal CryptoKey As String) As String
        Dim buffer() As Byte
        Dim CryptoClass As New TripleDESCryptoServiceProvider
        Dim CryptoProvider As New MD5CryptoServiceProvider
        Dim Vector() As Byte = {240, 3, 45, 29, 0, 76, 173, 59}
        Dim DecryptedString As String

        Try
            buffer = Convert.FromBase64String(InputString)
            CryptoClass.Key = CryptoProvider.ComputeHash(ASCIIEncoding.ASCII.GetBytes(CryptoKey))
            CryptoClass.IV = Vector
            DecryptedString = Encoding.ASCII.GetString(CryptoClass.CreateDecryptor().TransformFinalBlock(buffer, 0, buffer.Length()))

            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = SUCCESS

            Return DecryptedString
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CRYPT, DECRYPTION_ERROR)
            Return Constants.DEFAULTSTRINGVALUE
        Finally
            CryptoClass.Clear()
            CryptoProvider.Clear()
            CryptoClass = Nothing
            CryptoProvider = Nothing
        End Try

    End Function

    ''' <summary>
    ''' 3DES Encryption
    ''' </summary>
    ''' <param name="InputString">String to encrypt</param>
    ''' <param name="CryptoKey">The Key used to encrypt the string</param>
    ''' <returns>The encrypted string</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function Encrypt3DES(ByVal InputString As String, ByVal CryptoKey As String) As String
        Dim CryptoClass As New TripleDESCryptoServiceProvider
        Dim CryptoProvider As New MD5CryptoServiceProvider
        Dim Buffer() As Byte
        Dim Vector() As Byte = {240, 3, 45, 29, 0, 76, 173, 59}
        Dim EncryptedString As String

        Try
            Buffer = System.Text.Encoding.ASCII.GetBytes(InputString)
            CryptoClass.Key = CryptoProvider.ComputeHash(ASCIIEncoding.ASCII.GetBytes(CryptoKey))
            CryptoClass.IV = Vector
            InputString = Convert.ToBase64String(CryptoClass.CreateEncryptor().TransformFinalBlock(Buffer, 0, Buffer.Length()))
            EncryptedString = InputString

            LastStatus.Clear()
            LastStatus.CADS_ERRORCODE = SUCCESS

            Return EncryptedString
        Catch ex As Exception
            LastStatus.LastException = ex
            LastStatus.CADS_ERRORCODE = ErrorResult(ERRORTYPE.CRYPT, ENCRYPTION_ERROR)
            Return Constants.DEFAULTSTRINGVALUE
        Finally
            CryptoClass.Clear()
            CryptoProvider.Clear()
            CryptoClass = Nothing
            CryptoProvider = Nothing
        End Try
    End Function

    ''' <summary>
    ''' Rijndael 128 bit encryption
    ''' </summary>
    ''' <param name="StringToBeEncrypted">String To Be Encrypted</param>
    ''' <param name="EncryptionKey">Encryption Key</param>
    ''' <returns>EncryptedResult</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function EncryptString128Bit(ByVal StringToBeEncrypted As String, ByVal EncryptionKey As String) As String
        Dim bytValue() As Byte
        Dim bytKey() As Byte
        Dim bytEncoded() As Byte = {}
        Dim bytIV() As Byte = {121, 241, 10, 1, 132, 74, 11, 39, 255, 91, 45, 78, 14, 211, 22, 62}
        Dim intLength As Integer
        Dim intRemaining As Integer
        Dim objMemoryStream As New MemoryStream()
        Dim objCryptoStream As CryptoStream
        Dim objRijndaelManaged As RijndaelManaged
        Dim EncryptedResult As String

        '   **********************************************************************
        '   ******  Strip any null character from string to be encrypted    ******
        '   **********************************************************************

        StringToBeEncrypted = StripNullCharacters(StringToBeEncrypted)

        '   **********************************************************************
        '   ******  Value must be within ASCII range (i.e., no DBCS chars)  ******
        '   **********************************************************************

        bytValue = Encoding.ASCII.GetBytes(StringToBeEncrypted.ToCharArray)

        intLength = Len(EncryptionKey)

        '   ********************************************************************
        '   ******   Encryption Key must be 256 bits long (32 bytes)      ******
        '   ******   If it is longer than 32 bytes it will be truncated.  ******
        '   ******   If it is shorter than 32 bytes it will be padded     ******
        '   ******   with upper-case Xs.                                  ****** 
        '   ********************************************************************

        If intLength >= 32 Then
            EncryptionKey = Strings.Left(EncryptionKey, 32)
        Else
            intLength = Len(EncryptionKey)
            intRemaining = 32 - intLength
            EncryptionKey = EncryptionKey & Strings.StrDup(intRemaining, "X")
        End If

        bytKey = Encoding.ASCII.GetBytes(EncryptionKey.ToCharArray)

        objRijndaelManaged = New RijndaelManaged()

        '   ***********************************************************************
        '   ******  Create the encryptor and write value to it after it is   ******
        '   ******  converted into a byte array                              ******
        '   ***********************************************************************

        Try

            objCryptoStream = New CryptoStream(objMemoryStream, _
              objRijndaelManaged.CreateEncryptor(bytKey, bytIV), _
              CryptoStreamMode.Write)
            objCryptoStream.Write(bytValue, 0, bytValue.Length)

            objCryptoStream.FlushFinalBlock()

            bytEncoded = objMemoryStream.ToArray
            objMemoryStream.Close()
            objCryptoStream.Close()
        Catch

        End Try

        '   ***********************************************************************
        '   ******   Return encryptes value (converted from  byte Array to   ******
        '   ******   a base64 string).  Base64 is MIME encoding)             ******
        '   ***********************************************************************

        EncryptedResult = Convert.ToBase64String(bytEncoded)

        LastStatus.Clear()
        LastStatus.CADS_ERRORCODE = SUCCESS

        Return EncryptedResult
    End Function

    ''' <summary>
    ''' Rijndael 128 bit decryption
    ''' </summary>
    ''' <param name="StringToBeDecrypted">String To Be Decrypted</param>
    ''' <param name="DecryptionKey">Decryption Key</param>
    ''' <returns>DecryptedResult</returns>
    ''' <remarks>V1.0 D. Robinson</remarks>
    Public Function DecryptString128Bit(ByVal StringToBeDecrypted As String, ByVal DecryptionKey As String) As String
        Dim bytDataToBeDecrypted() As Byte
        Dim bytTemp() As Byte
        Dim bytIV() As Byte = {121, 241, 10, 1, 132, 74, 11, 39, 255, 91, 45, 78, 14, 211, 22, 62}
        Dim objRijndaelManaged As New RijndaelManaged()
        Dim objMemoryStream As MemoryStream
        Dim objCryptoStream As CryptoStream
        Dim bytDecryptionKey() As Byte

        Dim intLength As Integer
        Dim intRemaining As Integer
        Dim strReturnString As String = String.Empty
        Dim DecryptedResult As String

        '   *****************************************************************
        '   ******   Convert base64 encrypted value to byte array      ******
        '   *****************************************************************

        bytDataToBeDecrypted = Convert.FromBase64String(StringToBeDecrypted)

        '   ********************************************************************
        '   ******   Encryption Key must be 256 bits long (32 bytes)      ******
        '   ******   If it is longer than 32 bytes it will be truncated.  ******
        '   ******   If it is shorter than 32 bytes it will be padded     ******
        '   ******   with upper-case Xs.                                  ****** 
        '   ********************************************************************

        intLength = Len(DecryptionKey)

        If intLength >= 32 Then
            DecryptionKey = Strings.Left(DecryptionKey, 32)
        Else
            intLength = Len(DecryptionKey)
            intRemaining = 32 - intLength
            DecryptionKey = DecryptionKey & Strings.StrDup(intRemaining, "X")
        End If

        bytDecryptionKey = Encoding.ASCII.GetBytes(DecryptionKey.ToCharArray)

        ReDim bytTemp(bytDataToBeDecrypted.Length)

        objMemoryStream = New MemoryStream(bytDataToBeDecrypted)

        '   ***********************************************************************
        '   ******  Create the decryptor and write value to it after it is   ******
        '   ******  converted into a byte array                              ******
        '   ***********************************************************************

        Try

            objCryptoStream = New CryptoStream(objMemoryStream, _
               objRijndaelManaged.CreateDecryptor(bytDecryptionKey, bytIV), _
               CryptoStreamMode.Read)

            objCryptoStream.Read(bytTemp, 0, bytTemp.Length)

            objCryptoStream.FlushFinalBlock()
            objMemoryStream.Close()
            objCryptoStream.Close()

        Catch

        End Try

        '   *****************************************
        '   ******   Return decypted value     ******
        '   *****************************************

        DecryptedResult = StripNullCharacters(Encoding.ASCII.GetString(bytTemp))

        LastStatus.Clear()
        LastStatus.CADS_ERRORCODE = SUCCESS

        Return DecryptedResult
    End Function

    ''' <summary>
    ''' Strips NULL characters
    ''' </summary>
    ''' <param name="StringWithNulls"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Private Function StripNullCharacters(ByVal StringWithNulls As String) As String
        Dim Position As Integer = 0
        Dim StringWithoutNulls As String = ""

        Position = 1
        StringWithoutNulls = StringWithNulls

        Do While Position > 0
            Position = InStr(Position, StringWithNulls, vbNullChar)

            If Position > 0 Then
                StringWithoutNulls = Microsoft.VisualBasic.Left(StringWithoutNulls, Position - 1) & _
                                  Microsoft.VisualBasic.Right(StringWithoutNulls, Len(StringWithoutNulls) - Position)
            End If

            If Position > StringWithoutNulls.Length Then
                Exit Do
            End If
        Loop

        Return StringWithoutNulls

    End Function


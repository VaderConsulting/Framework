    Private Sub UpdateUserConfigFile()
        Dim ConfigFileSourceLocation As String = m_ConfigFileSourceLocation

        FileLoggingObject.WriteEvent("Inside UpdateUserConfigFile", LOGGING_LEVEL.DEBUGGING)

        FileLoggingObject.WriteEvent("Successfully read ConfigFileLocation as " & ConfigFileSourceLocation, LOGGING_LEVEL.DEBUGGING)

        Try
            If Not ConfigFileSourceLocation.EndsWith("\") Then ConfigFileSourceLocation = m_ConfigFileSourceLocation & "\"

            Try
                If Not IO.Directory.Exists(m_AppDataPath & "\users") Then
                    IO.Directory.CreateDirectory(m_AppDataPath & "\users")
                    FileLoggingObject.WriteEvent("Successfully created local path for User config files", LOGGING_LEVEL.DEBUGGING)
                End If
            Catch
                FileLoggingObject.WriteErrorEvent("Cannot create Users folder on the local machine")
            End Try

            IO.File.Copy(m_ConfigFileSourceLocation & "\users\" & InteractiveUserUsername & ".config", m_AppDataPath & "\users\" & InteractiveUserUsername & ".config", True)
            FileLoggingObject.WriteEvent("Successfully copied " & InteractiveUserUsername & ".config to local machine", LOGGING_LEVEL.DEBUGGING)
        Catch ex As Exception
            FileLoggingObject.WriteErrorEvent("Cannot copy " & InteractiveUserUsername & ".config to local machine")
            FileLoggingObject.WriteErrorEvent("The error message was: " & ex.Message)
            Debug.Print("UpdateUserConfigFile ERROR!!! " & ex.Message)
        End Try
    End Sub


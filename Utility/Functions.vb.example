#Region " General "

    ''' <summary>
    ''' Translates the ERROR_FILESYSTEM code into the CADS_ERRORCODE
    ''' </summary>
    ''' <param name="ErrorType">One of the defined CADS_ERROR_TYPES</param>
    ''' <param name="ErrorNumber">The ERROR_FILESYSTEM value to translate</param>
    ''' <returns>The CADS_ERRORCODE</returns>
    ''' <remarks>V1.0  D. Robinson</remarks>
    Public Function ErrorResult(ByVal ErrorType As ERRORTYPE, ByVal ErrorNumber As ERROR_FILESYSTEM) As Int32
        Dim Result As Int32 = (ErrorType * (2 ^ 16)) + ErrorNumber

        Return Result
    End Function

    ''' <summary>
    ''' Translates the ERROR_CONFIG code into the CADS_ERRORCODE
    ''' </summary>
    ''' <param name="ErrorType">One of the defined CADS_ERROR_TYPES</param>

Public Class frmLogin

    Private gFunctions As New Functions
    Private gSettings As New Collections.Specialized.OrderedDictionary

    Private Structure SettingsListItem
        Dim Index As Integer
        Dim Filename As String
        Dim Section As String
        Dim Setting As String
        Dim Value As String

        Overrides Function ToString() As String
            Return Section
        End Function
    End Structure

    Private Sub Form1_Load(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles MyBase.Load
        PerformLogon()
        LoadLogonSettings()
        LoadComboItems()

        btnLoadSection.Enabled = False
    End Sub

    Private Sub ImportCADS3Users(ByVal Source As String, ByVal Destination As String, ByVal Domain As String, ByVal Username As String, ByVal Password As String)
        Dim oAD As Utility.Functions = New Utility.Functions

        Dim Surname As String = "Bloggs"
        Dim Firstname As String = "Fred"
        Dim Department As String = "Here"

        Dim CNFormat As String = "#SURNAME#, #FIRSTNAME# (#DEPARTMENT#)"

        Dim TranslatedString As String = ""
        TranslatedString = TranslatedString.ToUpper.Replace("#SURNAME#", Surname)
        TranslatedString = TranslatedString.ToUpper.Replace("#FIRSTNAME#", Firstname)
        TranslatedString = TranslatedString.ToUpper.Replace("#DEPARTMENT#", Department)

        TranslatedString = "Bloggs, Fred (Here)"
    End Sub

    Private Sub PerformLogon()
        gFunctions.UpdateCADSConfigFile()      ' Copy cads.config to my PC

        Dim LogonResult As String = ""
        'LogonResult = gFunctions.DoLogon("Operator", "OperatorPassword", False)
        LogonResult = gFunctions.DoLogon()
        If LogonResult = Constants.DEFAULTSTRINGVALUE Then
            MsgBox("Your logon attempt has failed.")
            End
        End If

        Me.Text = "Settings Loader (" & gFunctions.InteractiveUserUsername & ")"

    End Sub

    Private Sub LoadLogonSettings()
        lstSettings.Items.Clear()

        gFunctions.CloneCollection(gFunctions.ConfigSettings, gSettings)  ' Get the Users settings into a collection so I can retrieve values directly

        Dim SettingNames As ICollection = gSettings.Keys
        Dim SettingValues As ICollection = gSettings.Values
        Dim iCounter As Int16 = 0

        For Each Field As String In gSettings.Values
            Dim SettingName As String = ""
            Dim SettingValue As String = ""

            SettingName = SettingNames(iCounter)
            SettingValue = SettingValues(iCounter)
            lstSettings.Items.Add(SettingName & "=" & SettingValue)
            iCounter += 1
        Next

        UpdateListboxCount()

        btnLoadSection.Enabled = True
    End Sub


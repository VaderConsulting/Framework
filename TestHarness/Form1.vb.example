    Private Sub btnLoadSection_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnLoadSection.Click
        If cmbSectionNames.Text.Length = 0 Then Exit Sub

        Dim Filename As String = Me.cmbSectionNames.SelectedItem.Filename
        Dim SectionName As String = Me.cmbSectionNames.SelectedItem.Section

        Me.txtCode.Text = "Dim m_Functions as new Functions" & vbCrLf
        Me.txtCode.Text &= "" & vbCrLf
        Me.txtCode.Text &= "m_Functions.ConfigFilenameAndPath = My.Application.Info.DirectoryPath & " & Chr(34) & "\" & Filename & Chr(34) & vbCrLf
        Me.txtCode.Text &= "m_Functions.LoadConfigSection(" & Chr(34) & SectionName & Chr(34) & ")"

        gFunctions.ConfigFilenameAndPath = My.Application.Info.DirectoryPath & "\" & Filename
        LoadSection(cmbSectionNames.Text)
    End Sub

    Private Sub LoadSection(ByVal SectionName As String)
        Dim TempCollection As New Collections.Specialized.OrderedDictionary

        gFunctions.LoadConfigSection(SectionName)

        gFunctions.CloneCollection(gFunctions.ConfigContents, TempCollection)

        Dim SettingNames As ICollection = TempCollection.Keys
        Dim SettingValues As ICollection = TempCollection.Values
        Dim iCounter As Int16 = 0

        For Each Field As String In TempCollection.Values
            Dim SettingName As String = ""
            Dim SettingValue As String = ""

            SettingName = SettingNames(iCounter)
            SettingValue = SettingValues(iCounter)
            lstSettings.Items.Add(SettingName & "=" & SettingValue)
            iCounter += 1
        Next

        UpdateListboxCount()

        btnLoadSection.Enabled = False
    End Sub

    Private Sub btnClear_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnClear.Click
        lstSettings.Items.Clear()
        UpdateListboxCount()
    End Sub

    Private Sub UpdateListboxCount()
        lblCount.Text = lstSettings.Items.Count.ToString & " Setting(s)."
    End Sub

    Private Sub cmbSectionNames_SelectedIndexChanged(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles cmbSectionNames.SelectedIndexChanged
        btnLoadSection.Enabled = True
    End Sub

